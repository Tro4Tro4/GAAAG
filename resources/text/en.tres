[gd_resource type="Resource" script_class="LocaleTexts" load_steps=2 format=3 uid="uid://baggatexten001"]

[ext_resource type="Script" path="res://scripts/text/locale_texts.gd" id="1_texts"]

[resource]
script = ExtResource("1_texts")
locale = "en"
entries = {
"INTRO_ORDER_HEADING": "COLLECTION ORDER",
"INTRO_ORDER_AUTHORITY": "Removals and Storage Service — Scheduled Collections",
"INTRO_ORDER_ARTICLE": "Having regard to article 12(3) (presumption of non-occupancy)",
"INTRO_ORDER_MISSING": "The certificate of occupancy not being on file",
"INTRO_ORDER_TERM": "The three years having elapsed, and nobody having written",
"INTRO_ORDER_ORDERS": "COLLECTION IS HEREBY ORDERED OF THE PROPERTY AND ALL APPURTENANCES",
"INTRO_ORDER_CLAUSE": "Please note that property travels and residents do not.",
"INTRO_ORDER_SIGNED": "Signature of the officer responsible: illegible",
"INTRO_ORDER_SUBJECT": "Item for collection: sector 9, district 41, body 3, inhabited surface, 14 Weavers Street.",
"SEQ_INTRO_ARRIVE": "You get home at ten past seven, the way you do every morning.",
"SEQ_INTRO_VAN": "The van was not there yesterday. And somebody is loading something that looks a great deal like the sofa from the landing.",
"SEQ_INTRO_NOTICE": "There is a sheet of paper on the front door. There has never been anything on the front door.",
"STREET_DOOR": "Front door",
"STREET_DOOR_LOOK": "The front door of your building. Today it is open, which it never is, and the reason is coming down the stairs with a wardrobe.",
"STREET_DOOR_ACT": "It is open already. They are holding it open with a rubber wedge that is not yours.",
"STREET_DOOR_REACH": "You go up. The stairs are still yours, and will be until midnight.",
"STREET_NOTICE": "Notice",
"STREET_NOTICE_LOOK": "NOTICE OF COLLECTION. The property will be collected. Objections to the competent office within the stated period. The period is not stated.",
"STREET_NOTICE_HAND": "You get it halfway off the door and stop. Taking down a notice is already an objection, and objections are made at the office.",
"STREET_BINS": "Bins",
"STREET_BINS_LOOK": "Two bins. One lid will not shut because of something that is not rubbish: it is the landing lamp, and the bulb is still in it.",
"STREET_BINS_ACT": "You lift the lid. Inside is half the landing, thrown in at some speed.",
"STREET_VAN": "Van",
"STREET_VAN_LOOK": "A removal van, reversed up to the depot shutter. There is a panel on the side where the name of the firm ought to be. There isn't one.",
"STREET_VAN_ACT": "You do not touch other people's vans. It is a rule you gave yourself today, just now, looking at it.",
"STREET_VAN_REACH": "There is nobody in the cab. The voices are coming from inside the front door, and they are going upwards.",
"STREET_BARRIER": "Barrier",
"STREET_BARRIER_LOOK": "A striped bar across the street, a post at one end and a leg at the other. Beyond it the road carries on exactly the same, which makes it more annoying rather than less.",
"STREET_BARRIER_ACT": "It is secured with a padlock and a twist of wire, in that order of importance.",
"STREET_BARRIER_REACH": "You duck down and go under. On the other side it is just a street.",
"STREET_ALLEY": "Alley",
"STREET_ALLEY_LOOK": "The alley between your building and the depot. It fits exactly one cat, and there is one, and it looks at you as though it knew.",
"STREET_ALLEY_REACH": "You get two steps in. Then there is a wall, and on the wall somebody has written a file number.",
"STREET_BELLS": "Doorbells",
"STREET_BELLS_LOOK": "Four bells. Three have a name on them. The fourth has a strip of tape with the same name as before, crossed out.",
"STREET_BELLS_ACT": "You ring your own. It rings in your flat, and you can hear it perfectly from the street, which until yesterday you could not.",
"STREET_DRAIN": "Drain",
"STREET_DRAIN_LOOK": "A drain. Something runs underneath it that can be heard and not seen, like most of this business.",
"STREET_DRAIN_HAND": "Your fingers go through the grating as far as the second knuckle and find water. You take your fingers back.",
"PROTO_LOBBY_DOOR_LOOK_OPEN": "The door stands open, and a wedge of light from the corridor spreads across the floor almost as far as the chairs.",
"PROTO_TUBES_DOOR_LOOK_OPEN": "The door stands wide open onto the lobby. From here you can see the floor beyond: the same grey, but with the air of having noticed.",
"PROTO_STATION_LEVER_ACT_DONE": "The lever is already down. The line is running backwards and nobody has told it for how long.",
"CHAR_LINO": "Lino",
"CHAR_CESARE": "Cesare",
"ITEM_FORM_BLANK": "Complaint form",
"ITEM_FORM_BLANK_LOOK": "A blank complaint form. Under «section concerned» there is a box that says: affix the section plate, original only.",
"ITEM_PLATE": "SECTION 4 plate",
"ITEM_PLATE_LOOK": "An enamelled plate reading SECTION 4. It was screwed under the porthole, with one screw, already half out.",
"ITEM_FORM_FILLED": "Filed complaint",
"ITEM_FORM_FILLED_LOOK": "The form with the plate stuck inside the box. Original only, as requested.",
"ITEM_RENEWAL": "Accreditation renewal",
"ITEM_RENEWAL_LOOK": "The firm's accreditation renewal. Date sent: three years ago. Date delivered: an empty box.",
"COMBO_FORM_PLATE": "You peel the backing off the plate and press it into the box. The form now says SECTION 4, original only, which is exactly what it asked for.",
"PROTO_LOBBY_NOTICE": "Regulations",
"PROTO_LOBBY_NOTICE_LOOK": "REGULATIONS, CLAUSE 6: complaints from the public travel on the return line. CLAUSE 7: staff are not the public.",
"PROTO_LOBBY_FORMS": "Form rack",
"PROTO_LOBBY_FORMS_LOOK": "A wall rack with two slots: COMPLAINTS and COMPLAINTS ABOUT THE RACK. The second one is empty.",
"PROTO_LOBBY_FORMS_HAND": "You take a complaint form from the slot that has some.",
"PROTO_LOBBY_FORMS_TAKEN": "There are forty more in the first slot. In the second there is still nothing at all.",
"PROTO_LOBBY_DOOR": "Corridor door",
"PROTO_LOBBY_DOOR_LOOK": "The door to the tube corridor. Above it, a sign: AUTHORISED STAFF AND INSPECTORS ONLY.",
"PROTO_LOBBY_DOOR_REACH": "You go into the corridor. Your pass raises no objection.",
"PROTO_LOBBY_CHAIRS": "Chairs",
"PROTO_LOBBY_CHAIRS_LOOK": "Four chairs in a row, for a lobby where nobody has waited in some time. One of them holds the shape of somebody, in dust.",
"PROTO_TUBES_PIPE": "Tube run",
"PROTO_TUBES_PIPE_LOOK": "The pneumatic tube runs the whole length of the wall and disappears at the far end. It is the only way this place has of telling itself anything.",
"PROTO_TUBES_PIPE_ACT": "You reach out and take your hand back. Touching the system under test voids the test, and the test is the only thing keeping you open.",
"PROTO_TUBES_PORTHOLE": "Inspection porthole",
"PROTO_TUBES_PORTHOLE_LOOK": "Inside the porthole a capsule is stuck sideways. Below it, a plate: SECTION 4.",
"PROTO_TUBES_PORTHOLE_LOOK_CLEAR": "There is nothing inside the porthole any more, and the glass is covered in dust that used to be somewhere else.",
"PROTO_TUBES_PORTHOLE_ACT": "The porthole only opens from inside the system, and the system is the thing you are testing.",
"PROTO_TUBES_PLATE": "Plate",
"PROTO_TUBES_PLATE_LOOK": "SECTION 4, screwed under the porthole with a single screw. Signage is not system: on this the regulations are perfectly clear.",
"PROTO_TUBES_PLATE_HAND": "You unscrew the plate with a fingernail. Signage is not system, and today that distinction saves your afternoon.",
"PROTO_TUBES_POINT": "Posting point",
"PROTO_TUBES_POINT_LOOK": "The public posting point. A brass mouth, and above it in small letters: PUBLIC. COLLECTIONS AT THE ADJACENT COUNTER, WHICH DOES NOT EXIST.",
"PROTO_TUBES_POINT_HAND": "Nothing in there. The return line works: it is the outward one that is stuck at section 4.",
"PROTO_TUBES_POINT_POSTED": "You post it. A puff of air takes it away, and for the first time today something in this place moves.",
"PROTO_TUBES_POINT_WAITING": "Something is poking out of the brass mouth. Somebody posted it from the other end.",
"PROTO_TUBES_DOOR": "Lobby door",
"PROTO_TUBES_DOOR_LOOK": "The door you came in by. On this side there is no sign at all, which is itself a position.",
"PROTO_TUBES_DOOR_REACH": "You go back to the lobby.",
"PROTO_TUBES_CAPSULE": "Capsule",
"PROTO_TUBES_CAPSULE_LOOK": "The capsule that was stuck at section 4. It came out of the public point with a thud and now sits there, dented and patient.",
"PROTO_TUBES_CAPSULE_HAND": "You open the capsule. There is one sheet inside, and you read it twice.",
"PROTO_STATION_CONSOLE": "Console",
"PROTO_STATION_CONSOLE_LOOK": "The tube console. One red lamp, one lever, and a terminal that answers anybody who asks it.",
"PROTO_STATION_LEVER": "Reversal lever",
"PROTO_STATION_LEVER_LOOK": "The lever that sends the line backwards. Above it, a label: ONLY WITH A LOGGED REASON.",
"PROTO_STATION_LEVER_ACT": "You pull the lever. The lever does not move: without a logged reason it is a piece of brass attached to a wall.",
"PROTO_STATION_LOG": "Log",
"PROTO_STATION_LOG_LOOK": "The log of reasons. The last line is three years old and reads: no reason.",
"PROTO_STATION_LOG_ACT": "You leaf through the log. Empty lines all the way down, every one with the date already printed on it.",
"PROTO_STATION_LOG_ACCEPTED": "You log the complaint. The log has one more line in it, and reversing the line now has a reason.",
"PROTO_STATION_POINT": "Service mouth",
"PROTO_STATION_POINT_LOOK": "The service mouth, where whatever the public posts arrives. Nothing has arrived since 2019.",
"PROTO_STATION_POINT_HAND": "Empty. As it has been for three years.",
"PROTO_STATION_POINT_POSTED": "You post it, and hope there is somebody at the other end.",
"PROTO_STATION_POINT_WAITING": "There is something in the service mouth. Something. In the service mouth.",
"DLG_CONSOLE_START": "TERMINAL READY. LINE OBSTRUCTED. DO NOT ASK WHERE.",
"DLG_CONSOLE_OPT_WHERE": "Where is it obstructed?",
"DLG_CONSOLE_REPLY_WHERE": "I TOLD YOU NOT TO ASK. THE TERMINAL CANNOT SEE INSIDE THE LINE: THAT IS WHAT THE PORTHOLE IS FOR, AND IT IS IN THE CORRIDOR.",
"DLG_CONSOLE_OPT_REVERSE": "Can I reverse the line?",
"DLG_CONSOLE_REPLY_REVERSE": "WITH A LOGGED REASON. A VALID REASON IS A COMPLAINT FROM THE PUBLIC. YOU ARE NOT THE PUBLIC: YOU ARE HERE.",
"DLG_CONSOLE_OPT_COMPLAIN": "Then I will file a complaint myself.",
"DLG_CONSOLE_REPLY_COMPLAIN": "STAFF POST COMPLAINTS IN THE SERVICE MOUTH. THE SERVICE MOUTH IS ON THE OBSTRUCTED LINE. NOTE THE ELEGANCE.",
"DLG_CONSOLE_OPT_READY": "I have a logged complaint.",
"DLG_CONSOLE_REPLY_READY": "THEN THE LEVER WILL MOVE. I SAY THIS WITHOUT ENTHUSIASM BECAUSE I HAVE NONE.",
"DLG_CONSOLE_OPT_BYE": "Fine.",
"DLG_CONSOLE_REPLY_BYE": "TERMINAL STANDING BY. AS EVER.",
"SEQ_LEVER_PULL": "You pull the lever, and this time it goes down.",
"SEQ_LEVER_RUMBLE": "The tube makes a noise it has not made in three years. Something heavy comes back along the whole length of the wall.",
"SEQ_LEVER_END": "Then silence, and a distant thud from the direction of the lobby.",
"GENERIC_COMBINE_REFUSAL": "Together they do absolutely nothing.",
"GENERIC_DOOR_CLOSE": "You close the door.",
"GENERIC_DOOR_OPEN": "You open the door.",
"GENERIC_ITEM_REFUSAL": "That has nothing to do with this.",
"GENERIC_PASSAGE_EMPTY": "There is nothing in there, for now.",
"GENERIC_PASSAGE_POSTED": "It vanishes to the other side.",
"GENERIC_PASSAGE_TAKE": "You take %s.",
"GENERIC_REFUSAL": "That does not strike me as a good idea.",
"MENU_LOAD": "Load",
"MENU_QUIT": "Quit",
"MENU_SETTINGS": "Settings",
"MENU_LOAD_AUTO": "Load the last autosave",
"MENU_NEW_GAME": "New game",
"MENU_SAVE": "Save",
"SETTINGS_LANGUAGE": "Language",
"SETTINGS_MUSIC": "Music: %d%%",
"SETTINGS_SOUND": "Sound: %d%%",
"SETTINGS_TITLE": "Settings",
"TITLE_CONTINUE": "Continue",
"UI_BAG": "Bag",
"UI_EMPTY_BAG": "You are not carrying anything.",
"UI_LOADED": "Game loaded.",
"UI_LOAD_FAILED": "This saved game cannot be read.",
"UI_MENU": "Menu",
"UI_NOTHING_TO_LOAD": "There is nothing to load.",
"UI_SAVED": "Game saved.",
"UI_SAVE_FAILED": "The game could not be saved.",
"UI_USING": "Use %s with...",
"VERB_CLOSE": "Close",
"VERB_GO": "Go",
"VERB_LOOK": "Look",
"VERB_OPEN": "Open",
"VERB_TAKE": "Take",
"VERB_TALK": "Talk",
"VERB_USE": "Use",
"APT_DOOR": "Front door",
"APT_DOOR_LOOK": "The door of your flat, held open by a rubber wedge that is not yours. There is more light on the landing than in here.",
"APT_DOOR_REACH": "You go down to the street.",
"APT_BOXES": "Boxes",
"APT_BOXES_LOOK": "Your things, in boxes you did not buy, shut with tape you did not unroll. Each one has a tag on it, and each tag has one printed line.",
"APT_BOXES_HAND": "You lift a corner of the tape. The clerk does not look up: \"That is on the list.\" You put the corner of the tape back.",
"APT_BOXES_ACT": "The boxes are shut, and opening them in front of the man who shut them looks like an argument you would lose.",
"APT_DOCBOX": "Document box",
"APT_DOCBOX_LOOK": "The box with your papers in it. You have never opened it since you arrived: the tape from back then is still on it, yellow, and the delivery label with the date.",
"APT_DOCBOX_LOOK_FREE": "The document box, with a line of ink through its tag. Now it is only a box.",
"APT_DOCBOX_HAND": "You tuck it under your arm. It weighs about three years of things you never looked at.",
"APT_DOCBOX_REFUSED": "You try. \"That one is on the list,\" says the clerk, without looking at which one.",
"APT_DOCBOX_TAKEN": "You already have it under your arm, and it is more awkward than it looks.",
"APT_CLERK": "Loading clerk",
"APT_CLERK_LOOK": "He is not carrying anything down. He has a clipboard, a pen behind his ear, and the look of somebody who has been standing up for longer than you have.",
"APT_WINDOW": "Window",
"APT_WINDOW_LOOK": "From here you can see the roof of the van. They are loading something long, wrapped in a blanket, and the blanket is yours.",
"APT_WINDOW_ACT": "You open it. Cold air comes in, and the sound of people working well. You shut it again.",
"APT_MATTRESS": "Mattress",
"APT_MATTRESS_LOOK": "Rolled and tied in two places, with knots made by somebody who knows how to make knots. You do not remember sleeping on a rolled-up mattress, and indeed tonight you will not.",
"APT_MATTRESS_HAND": "You move the mattress four inches. Now the floor under it is dusty in a different shape.",
"SEQ_APT_LABEL": "Under the tape there is still the delivery label from when you moved in. A date, a number, and the word DELIVERED, printed crooked.",
"DLG_CLERK_START": "\"Please do not touch anything. It is all on the list.\"",
"DLG_CLERK_OPT_WHO": "And who might you be?",
"DLG_CLERK_REPLY_WHO": "\"Loading clerk. I do not carry anything down. I tick.\"",
"DLG_CLERK_OPT_LIST": "What is this list?",
"DLG_CLERK_REPLY_LIST": "\"The appurtenances of the property. The property leaves, and its appurtenances leave with it. Otherwise it arrives empty and then there is trouble.\"",
"DLG_CLERK_OPT_MINE": "But those are my things.",
"DLG_CLERK_REPLY_MINE": "\"Those are things that were inside. It is a different word, and the list uses that one.\"",
"DLG_CLERK_OPT_STRIKE": "And if something were not to go?",
"DLG_CLERK_REPLY_STRIKE": "\"I can only strike off what is already recorded as delivered. A thing already delivered cannot be withdrawn: that would be a second withdrawal of the same thing, and a second withdrawal is not provided for.\"",
"DLG_CLERK_OPT_LABEL": "There is a delivery label on the document box. Look at the date.",
"DLG_CLERK_LABEL": "He goes over, bends down, reads. He stays bent down a moment longer than he needs to. \"...Mm.\"",
"DLG_CLERK_OPT_LABEL_YES": "So it is already recorded as delivered.",
"DLG_CLERK_REPLY_LABEL_YES": "\"It is.\" He takes the pen from behind his ear and rules a line through the tag, with a ruler, because a crooked line does not count. \"That one is not ours.\"",
"DLG_CLERK_OPT_LABEL_NO": "Never mind, forget it.",
"DLG_CLERK_OPT_THANKS": "Thank you.",
"DLG_CLERK_REPLY_THANKS": "\"Do not thank me. If you find me another one like that, I will strike that off too, and at the end of the day they ask me why the load is light.\"",
"DLG_CLERK_OPT_BYE": "I will be off.",
"DLG_CLERK_REPLY_BYE": "\"Take your time. Until midnight it is your house.\"",
"ITEM_DOCUMENTS": "Document box",
"ITEM_DOCUMENTS_LOOK": "Everything that proves you exist, in a box that proves it has already been delivered.",
"STREET_BARRIER_LOCKED": "The bar is down and the man watching it is two steps away. Ducking under without saying anything would be the stupidest thing you do today, and the day is long.",
"STREET_WARDEN": "Warden",
"STREET_WARDEN_LOOK": "Tabard, cap, hands behind his back. He has no clipboard: his list is on the post beside him, and he knows it by heart.",
"DLG_WARDEN_START": "\"District under removal. Residents and personnel through here. You?\"",
"DLG_WARDEN_OPT_WHY": "Why is it closed?",
"DLG_WARDEN_REPLY_WHY": "\"Because when a property is moved, people stop to watch. And anybody who stops to watch is recorded as present. Then it all has to be reclassified, and that is not my department.\"",
"DLG_WARDEN_OPT_RESIDENT": "I am a resident.",
"DLG_WARDEN_REPLY_RESIDENT": "\"Then you have something that says so. Not who you are: where you live.\"",
"DLG_WARDEN_OPT_ID": "I have an identity document.",
"DLG_WARDEN_REPLY_ID": "\"That says who. I need where. Two different departments, and they have not spoken since before I was born.\"",
"DLG_WARDEN_OPT_SHOW": "Look at this delivery label.",
"DLG_WARDEN_SHOW": "He takes the box, turns it to the light, reads. Reads it a second time. \"This is three years old.\"",
"DLG_WARDEN_OPT_SHOW_YES": "It says something was delivered to that address. It does not say it has to be recent.",
"DLG_WARDEN_REPLY_SHOW_YES": "\"...No. It does not.\" He lifts the bar about a foot and a half, enough to duck under. \"Be back before midnight. After that you are not a resident, and I will not let you back in.\"",
"DLG_WARDEN_OPT_SHOW_NO": "Never mind.",
"DLG_WARDEN_OPT_AGAIN": "Going through again.",
"DLG_WARDEN_REPLY_AGAIN": "\"You have shown me. Go on.\"",
"DLG_WARDEN_OPT_BYE": "I will be off.",
"DLG_WARDEN_REPLY_BYE": "\"Stay on this side.\"",
"PROTO_LOBBY_ENTRANCE": "Entrance",
"PROTO_LOBBY_ENTRANCE_LOOK": "The glass door you came in by, held open by a stop. Above it a plate with the name of the office on it, and the name is longer than the plate.",
"PROTO_LOBBY_ENTRANCE_REACH": "You go out to the street."
}
