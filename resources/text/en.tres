[gd_resource type="Resource" script_class="LocaleTexts" load_steps=2 format=3 uid="uid://baggatexten001"]

[ext_resource type="Script" path="res://scripts/text/locale_texts.gd" id="1_texts"]

[resource]
script = ExtResource("1_texts")
locale = "en"
entries = {
"INTRO_ORDER_HEADING": "COLLECTION ORDER",
"INTRO_ORDER_AUTHORITY": "Removals and Storage Service — Scheduled Collections",
"INTRO_ORDER_ARTICLE": "Having regard to article 12(3) (presumption of non-occupancy)",
"INTRO_ORDER_MISSING": "The certificate of occupancy not being on file",
"INTRO_ORDER_TERM": "The three years having elapsed, and nobody having written",
"INTRO_ORDER_ORDERS": "COLLECTION IS HEREBY ORDERED OF THE PROPERTY AND ALL APPURTENANCES",
"INTRO_ORDER_CLAUSE": "Please note that property travels and residents do not.",
"INTRO_ORDER_SIGNED": "Signature of the officer responsible: illegible",
"INTRO_ORDER_SUBJECT": "Item for collection: sector 9, district 41, body 3, inhabited surface, 14 Weavers Street.",
"SEQ_INTRO_ARRIVE": "You get home at ten past seven, the way you do every morning.",
"SEQ_INTRO_VAN": "The van was not there yesterday. And somebody is loading something that looks a great deal like the sofa from the landing.",
"SEQ_INTRO_NOTICE": "There is a sheet of paper on the front door. There has never been anything on the front door.",
"STREET_DOOR": "Front door",
"STREET_DOOR_LOOK": "The front door of your building. Today it is open, which it never is, and the reason is coming down the stairs with a wardrobe.",
"STREET_DOOR_ACT": "It is open already. They are holding it open with a rubber wedge that is not yours.",
"STREET_DOOR_REACH": "You go up. The stairs are still yours, and will be until midnight.",
"STREET_NOTICE": "Notice",
"STREET_NOTICE_LOOK": "NOTICE OF COLLECTION. The property will be collected. Objections to the competent office within the stated period. The period is not stated.",
"STREET_NOTICE_HAND": "You get it halfway off the door and stop. Taking down a notice is already an objection, and objections are made at the office.",
"STREET_BINS": "Bins",
"STREET_BINS_LOOK": "Two bins. One lid will not shut because of something that is not rubbish: it is the landing lamp, and the bulb is still in it.",
"STREET_BINS_ACT": "You lift the lid. Inside is half the landing, thrown in at some speed.",
"STREET_VAN": "Van",
"STREET_VAN_LOOK": "A removal van, reversed up to the depot shutter. There is a panel on the side where the name of the firm ought to be. There isn't one.",
"STREET_VAN_ACT": "You do not touch other people's vans. It is a rule you gave yourself today, just now, looking at it.",
"STREET_VAN_REACH": "There is nobody in the cab. The voices are coming from inside the front door, and they are going upwards.",
"STREET_BARRIER": "Barrier",
"STREET_BARRIER_LOOK": "A striped bar across the street, a post at one end and a leg at the other. Beyond it the road carries on exactly the same, which makes it more annoying rather than less.",
"STREET_BARRIER_ACT": "It is secured with a padlock and a twist of wire, in that order of importance.",
"STREET_BARRIER_REACH": "You duck down and go under. On the other side it is just a street.",
"STREET_ALLEY": "Alley",
"STREET_ALLEY_LOOK": "The alley between your building and the depot. It fits exactly one cat, and there is one, and it looks at you as though it knew.",
"STREET_ALLEY_REACH": "You get two steps in. Then there is a wall, and on the wall somebody has written a file number.",
"STREET_BELLS": "Doorbells",
"STREET_BELLS_LOOK": "Four bells. Three have a name on them. The fourth has a strip of tape with the same name as before, crossed out.",
"STREET_BELLS_ACT": "You ring your own. It rings in your flat, and you can hear it perfectly from the street, which until yesterday you could not.",
"STREET_DRAIN": "Drain",
"STREET_DRAIN_LOOK": "A drain. Something runs underneath it that can be heard and not seen, like most of this business.",
"STREET_DRAIN_HAND": "Your fingers go through the grating as far as the second knuckle and find water. You take your fingers back.",
"LOBBY_DOOR_LOOK_OPEN": "The door stands open, and a wedge of light from the corridor spreads across the floor almost as far as the chairs.",
"TUBES_DOOR_LOOK_OPEN": "The door stands wide open onto the lobby. From here you can see the floor beyond: the same grey, but with the air of having noticed.",
"STATION_LEVER_ACT_DONE": "The lever is already down. The line is running backwards and nobody has told it for how long.",
"CHAR_LINO": "Lino",
"CHAR_CESARE": "Cesare",
"ITEM_FORM_BLANK": "Complaint form",
"ITEM_FORM_BLANK_LOOK": "A blank complaint form. Under «section concerned» there is a box that says: affix the section plate, original only.",
"ITEM_PLATE": "SECTION 4 plate",
"ITEM_PLATE_LOOK": "An enamelled plate reading SECTION 4. It was screwed under the porthole, with one screw, already half out.",
"ITEM_FORM_FILLED": "Filed complaint",
"ITEM_FORM_FILLED_LOOK": "The form with the plate stuck inside the box. Original only, as requested.",
"ITEM_CERTIFICATE": "Certificate of occupation",
"ITEM_CERTIFICATE_LOOK": "The certificate that says somebody lives at these addresses. Date of dispatch: three years ago. Date of delivery: an empty box. At the bottom is the list of certified addresses, and yours is the last one.",
"COMBO_FORM_PLATE": "You peel the backing off the plate and press it into the box. The form now says SECTION 4, original only, which is exactly what it asked for.",
"LOBBY_NOTICE": "Regulations",
"LOBBY_NOTICE_LOOK": "REGULATIONS, CLAUSE 6: complaints from the public travel on the return line and must be logged. CLAUSE 7: staff are not the public. CLAUSE 8: the public are not staff.",
"LOBBY_FORMS": "Form rack",
"LOBBY_FORMS_LOOK": "A wall rack with two compartments: COMPLAINTS and COMPLAINTS ABOUT THE RACK. The second is empty.",
"LOBBY_FORMS_HAND": "You take a complaint form from the full compartment. You came here to oppose the withdrawal of your home and you are holding a sheet about pipework: that is how it goes here, and if the pipework does not work then nothing does.",
"LOBBY_FORMS_TAKEN": "There are forty more in the first slot. In the second there is still nothing at all.",
"LOBBY_DOOR": "Corridor door",
"LOBBY_DOOR_LOOK": "The door to the tube corridor. Above it, a sign: PUBLIC INSPECTION GALLERY. DO NOT TOUCH THE INSTALLATION.",
"LOBBY_DOOR_REACH": "You go into the gallery. Nobody stops you: it is public, it says so.",
"LOBBY_CHAIRS": "Chairs",
"LOBBY_CHAIRS_LOOK": "Four chairs in a row for a lobby where nobody has waited in a long time. On one of them is the shape of somebody, in dust, and the dust is as old as this place's silence.",
"TUBES_PIPE": "Tube run",
"TUBES_PIPE_LOOK": "The pneumatic post runs the whole length of the wall and disappears at the far end. It is the only way this office has of sending what it certifies.",
"TUBES_PIPE_ACT": "You reach out and take your hand back. You are the public, and the public does not touch the installation: it is the first line on the sign and the only one in large letters.",
"TUBES_PORTHOLE": "Inspection porthole",
"TUBES_PORTHOLE_LOOK": "Inside the porthole a capsule sits jammed across the pipe. Below it, a plate: SECTION 4.",
"TUBES_PORTHOLE_LOOK_CLEAR": "There is nothing inside the porthole any more, and the glass is covered in dust that used to be somewhere else.",
"TUBES_PORTHOLE_ACT": "The porthole only opens from inside the installation, and there is nowhere you can get to the installation from.",
"TUBES_PLATE": "Plate",
"TUBES_PLATE_LOOK": "SECTION 4, screwed under the porthole with a single screw. Signage is not installation: the regulations are perfectly clear on that.",
"TUBES_PLATE_HAND": "You unscrew the plate with a fingernail. Signage is not installation, and today that distinction saves your day.",
"TUBES_POINT": "Posting point",
"TUBES_POINT_LOOK": "The public posting slot. A brass mouth, and above it in small letters: PUBLIC. What you post here comes out on the staff side, and on the staff side there is somebody.",
"TUBES_POINT_HAND": "There is nothing in it. The return line works: it is the outward one that is stuck at section 4.",
"TUBES_POINT_POSTED": "You post it. A puff of air takes it away, and for the first time today something in this place moves. On the other side, now, there is somebody with something to do.",
"TUBES_POINT_WAITING": "Something is poking out of the brass mouth. Somebody posted it from the other end.",
"TUBES_DOOR": "Lobby door",
"TUBES_DOOR_LOOK": "The door you came in by. On this side there is no sign at all, which is itself a position.",
"TUBES_DOOR_REACH": "You go back to the lobby.",
"TUBES_CAPSULE": "Capsule",
"TUBES_CAPSULE_LOOK": "The capsule that was stuck at section 4. It came out of the public slot with a thud and now it sits there, dented and patient.",
"TUBES_CAPSULE_HAND": "You open the capsule. There is a single sheet inside, and you read it twice.",
"STATION_CONSOLE": "Console",
"STATION_CONSOLE_LOOK": "The console of the pneumatic post. One red lamp, one lever, and a terminal that answers whoever asks it.",
"STATION_LEVER": "Reversal lever",
"STATION_LEVER_LOOK": "The lever that sends the line backwards. Above it, a label: ONLY WITH A LOGGED REASON.",
"STATION_LEVER_ACT": "You pull the lever. The lever does not move: without a logged reason it is a piece of brass attached to a wall.",
"STATION_LOG": "Log",
"STATION_LOG_LOOK": "The register of reasons. The last line is three years old and says: no reason.",
"STATION_LOG_ACT": "You leaf through the log. Empty lines all the way down, every one with the date already printed on it.",
"STATION_LOG_ACCEPTED": "You log the complaint. The log has one more line in it, and reversing the line now has a reason.",
"STATION_POINT": "Service mouth",
"STATION_POINT_LOOK": "The service hatch, where whatever the public posts arrives. Nothing has arrived in it for three years.",
"STATION_POINT_HAND": "Empty. As it has been for three years.",
"STATION_POINT_POSTED": "You post it, and hope there is somebody at the other end.",
"STATION_POINT_WAITING": "There is something in the service mouth. Something. In the service mouth.",
"DLG_CONSOLE_START": "TERMINAL READY. LINE OBSTRUCTED. DO NOT ASK WHERE.",
"DLG_CONSOLE_OPT_WHERE": "Where is it obstructed?",
"DLG_CONSOLE_REPLY_WHERE": "I TOLD YOU NOT TO ASK. THE TERMINAL CANNOT SEE INSIDE THE LINE: THAT IS WHAT THE PORTHOLE IS FOR, AND IT IS IN THE CORRIDOR.",
"DLG_CONSOLE_OPT_REVERSE": "Can I reverse the line?",
"DLG_CONSOLE_REPLY_REVERSE": "WITH A LOGGED REASON. A VALID REASON IS A COMPLAINT FROM THE PUBLIC. YOU ARE NOT THE PUBLIC: YOU ARE HERE.",
"DLG_CONSOLE_OPT_COMPLAIN": "Then I will file a complaint myself.",
"DLG_CONSOLE_REPLY_COMPLAIN": "STAFF POST COMPLAINTS IN THE SERVICE MOUTH. THE SERVICE MOUTH IS ON THE OBSTRUCTED LINE. NOTE THE ELEGANCE.",
"DLG_CONSOLE_OPT_READY": "I have a logged complaint.",
"DLG_CONSOLE_REPLY_READY": "THEN THE LEVER WILL MOVE. I SAY THIS WITHOUT ENTHUSIASM BECAUSE I HAVE NONE.",
"DLG_CONSOLE_OPT_BYE": "Fine.",
"DLG_CONSOLE_REPLY_BYE": "TERMINAL STANDING BY. AS EVER.",
"SEQ_LEVER_PULL": "You pull the lever, and this time it goes down.",
"SEQ_LEVER_RUMBLE": "The tube makes a noise it has not made in three years. Something heavy comes back along the whole length of the wall.",
"SEQ_LEVER_END": "Then silence, and a distant thud from the direction of the lobby.",
"GENERIC_COMBINE_REFUSAL": "Together they do absolutely nothing.",
"GENERIC_DOOR_CLOSE": "You close the door.",
"GENERIC_DOOR_OPEN": "You open the door.",
"GENERIC_ITEM_REFUSAL": "That has nothing to do with this.",
"GENERIC_PASSAGE_EMPTY": "There is nothing in there, for now.",
"GENERIC_PASSAGE_POSTED": "It vanishes to the other side.",
"GENERIC_PASSAGE_TAKE": "You take %s.",
"GENERIC_REFUSAL": "That does not strike me as a good idea.",
"MENU_LOAD": "Load",
"MENU_QUIT": "Quit",
"MENU_SETTINGS": "Settings",
"MENU_LOAD_AUTO": "Load the last autosave",
"MENU_NEW_GAME": "New game",
"MENU_SAVE": "Save",
"SETTINGS_LANGUAGE": "Language",
"SETTINGS_MUSIC": "Music: %d%%",
"SETTINGS_SOUND": "Sound: %d%%",
"SETTINGS_TITLE": "Settings",
"TITLE_CONTINUE": "Continue",
"UI_BAG": "Bag",
"UI_EMPTY_BAG": "You are not carrying anything.",
"UI_LOADED": "Game loaded.",
"UI_LOAD_FAILED": "This saved game cannot be read.",
"UI_MENU": "Menu",
"UI_NOTHING_TO_LOAD": "There is nothing to load.",
"UI_SAVED": "Game saved.",
"UI_SAVE_FAILED": "The game could not be saved.",
"UI_USING": "Use %s with...",
"VERB_CLOSE": "Close",
"VERB_GO": "Go",
"VERB_LOOK": "Look",
"VERB_OPEN": "Open",
"VERB_TAKE": "Take",
"VERB_TALK": "Talk",
"VERB_USE": "Use",
"APT_DOOR": "Front door",
"APT_DOOR_LOOK": "The door of your flat, held open by a rubber wedge that is not yours. There is more light on the landing than in here.",
"APT_DOOR_REACH": "You go down to the street.",
"APT_BOXES": "Boxes",
"APT_BOXES_LOOK": "Your things, in boxes you did not buy, shut with tape you did not unroll. Each one has a tag on it, and each tag has one printed line.",
"APT_BOXES_HAND": "You lift a corner of the tape. The clerk does not look up: \"That is on the list.\" You put the corner of the tape back.",
"APT_BOXES_ACT": "The boxes are shut, and opening them in front of the man who shut them looks like an argument you would lose.",
"APT_DOCBOX": "Document box",
"APT_DOCBOX_LOOK": "The box with your papers in it. You have never opened it since you arrived: the tape from back then is still on it, yellow, and the delivery label with the date.",
"APT_DOCBOX_LOOK_FREE": "The document box, with a line of ink through its tag. Now it is only a box.",
"APT_DOCBOX_HAND": "You tuck it under your arm. It weighs about three years of things you never looked at.",
"APT_DOCBOX_REFUSED": "You try. \"That one is on the list,\" says the clerk, without looking at which one.",
"APT_DOCBOX_TAKEN": "You already have it under your arm, and it is more awkward than it looks.",
"APT_CLERK": "Loading clerk",
"APT_CLERK_LOOK": "He is not carrying anything down. He has a clipboard, a pen behind his ear, and the look of somebody who has been standing up for longer than you have.",
"APT_WINDOW": "Window",
"APT_WINDOW_LOOK": "From here you can see the roof of the van. They are loading something long, wrapped in a blanket, and the blanket is yours.",
"APT_WINDOW_ACT": "You open it. Cold air comes in, and the sound of people working well. You shut it again.",
"APT_MATTRESS": "Mattress",
"APT_MATTRESS_LOOK": "Rolled and tied in two places, with knots made by somebody who knows how to make knots. You do not remember sleeping on a rolled-up mattress, and indeed tonight you will not.",
"APT_MATTRESS_HAND": "You move the mattress four inches. Now the floor under it is dusty in a different shape.",
"SEQ_APT_LABEL": "Under the tape there is still the delivery label from when you moved in. A date, a number, and the word DELIVERED, printed crooked.",
"DLG_CLERK_START": "\"Please do not touch anything. It is all on the list.\"",
"DLG_CLERK_OPT_WHO": "And who might you be?",
"DLG_CLERK_REPLY_WHO": "\"Loading clerk. I do not carry anything down. I tick.\"",
"DLG_CLERK_OPT_LIST": "What is this list?",
"DLG_CLERK_REPLY_LIST": "\"The appurtenances of the property. The property leaves, and its appurtenances leave with it. Otherwise it arrives empty and then there is trouble.\"",
"DLG_CLERK_OPT_MINE": "But those are my things.",
"DLG_CLERK_REPLY_MINE": "\"Those are things that were inside. It is a different word, and the list uses that one.\"",
"DLG_CLERK_OPT_STRIKE": "And if something were not to go?",
"DLG_CLERK_REPLY_STRIKE": "\"I can only strike off what is already recorded as delivered. A thing already delivered cannot be withdrawn: that would be a second withdrawal of the same thing, and a second withdrawal is not provided for.\"",
"DLG_CLERK_OPT_LABEL": "There is a delivery label on the document box. Look at the date.",
"DLG_CLERK_LABEL": "He goes over, bends down, reads. He stays bent down a moment longer than he needs to. \"...Mm.\"",
"DLG_CLERK_OPT_LABEL_YES": "So it is already recorded as delivered.",
"DLG_CLERK_REPLY_LABEL_YES": "\"It is.\" He takes the pen from behind his ear and rules a line through the tag, with a ruler, because a crooked line does not count. \"That one is not ours.\"",
"DLG_CLERK_OPT_LABEL_NO": "Never mind, forget it.",
"DLG_CLERK_OPT_THANKS": "Thank you.",
"DLG_CLERK_REPLY_THANKS": "\"Do not thank me. If you find me another one like that, I will strike that off too, and at the end of the day they ask me why the load is light.\"",
"DLG_CLERK_OPT_BYE": "I will be off.",
"DLG_CLERK_REPLY_BYE": "\"Take your time. Until midnight it is your house.\"",
"ITEM_DOCUMENTS": "Document box",
"ITEM_DOCUMENTS_LOOK": "Everything that proves you exist, in a box that proves it has already been delivered.",
"STREET_BARRIER_LOCKED": "The bar is down and the man watching it is two steps away. Ducking under without saying anything would be the stupidest thing you do today, and the day is long.",
"STREET_WARDEN": "Warden",
"STREET_WARDEN_LOOK": "Tabard, cap, hands behind his back. He has no clipboard: his list is on the post beside him, and he knows it by heart.",
"DLG_WARDEN_START": "\"District under removal. Residents and personnel through here. You?\"",
"DLG_WARDEN_OPT_WHY": "Why is it closed?",
"DLG_WARDEN_REPLY_WHY": "\"Because when a property is moved, people stop to watch. And anybody who stops to watch is recorded as present. Then it all has to be reclassified, and that is not my department.\"",
"DLG_WARDEN_OPT_RESIDENT": "I am a resident.",
"DLG_WARDEN_REPLY_RESIDENT": "\"Then you have something that says so. Not who you are: where you live.\"",
"DLG_WARDEN_OPT_ID": "I have an identity document.",
"DLG_WARDEN_REPLY_ID": "\"That says who. I need where. Two different departments, and they have not spoken since before I was born.\"",
"DLG_WARDEN_OPT_SHOW": "Look at this delivery label.",
"DLG_WARDEN_SHOW": "He takes the box, turns it to the light, reads. Reads it a second time. \"This is three years old.\"",
"DLG_WARDEN_OPT_SHOW_YES": "It says something was delivered to that address. It does not say it has to be recent.",
"DLG_WARDEN_REPLY_SHOW_YES": "\"...No. It does not.\" He lifts the bar about a foot and a half, enough to duck under. \"Be back before midnight. After that you are not a resident, and I will not let you back in.\"",
"DLG_WARDEN_OPT_SHOW_NO": "Never mind.",
"DLG_WARDEN_OPT_AGAIN": "Going through again.",
"DLG_WARDEN_REPLY_AGAIN": "\"You have shown me. Go on.\"",
"DLG_WARDEN_OPT_BYE": "I will be off.",
"DLG_WARDEN_REPLY_BYE": "\"Stay on this side.\"",
"LOBBY_ENTRANCE": "Entrance",
"LOBBY_ENTRANCE_LOOK": "The glass door you came in by, held open by a stop. Above it a plate: OFFICE OF OCCUPATION CERTIFICATES. The name is longer than the plate and the last two letters are painted on the wall.",
"LOBBY_ENTRANCE_REACH": "You go out to the street.",
"LAND_BELLS": "Doorbells",
"LAND_BELLS_LOOK": "Six buttons and two names. The other four cards have been taken out, and underneath you can see the fresh card from when they were put in.",
"LAND_BELLS_ACT": "You ring your own. Your bell rings inside your flat, which is empty, and you hear it through the door. It is a noise that used to mean nothing and now means something.",
"LAND_METERS": "Meter cupboard",
"LAND_METERS_LOOK": "The meter cupboard, its paint coming off in flakes. Above it, a faded sticker for a company that no longer exists.",
"LAND_METERS_ACT": "Inside there are three meters and an envelope. The envelope is for the tenant on the second floor, who left before you arrived.",
"LAND_FLAT_DOOR": "Your front door",
"LAND_FLAT_DOOR_LOOK": "Your door, with the withdrawal notice stuck in the middle of it. It is the same sheet as the one downstairs, printed smaller, and taped on by the same hand.",
"LAND_FLAT_DOOR_REACH": "You go inside.",
"LAND_DUILIO_DOOR": "Duilio's door",
"LAND_DUILIO_DOOR_LOOK": "The same door as yours, with a piece of cardboard hung where the notice would be. On the cardboard: EMPTY, in the handwriting of somebody who wrote it for himself and not for anybody else.",
"LAND_DUILIO_DOOR_ACT": "It is open and there is nothing inside. Not even boxes: Duilio did not wait for them to come and pack his things.",
"LAND_STAIRS_DOWN": "Stairs to the cellar",
"LAND_STAIRS_DOWN_LOOK": "The stairs down to the cellar. The light on the landing below is on, and you did not turn it on.",
"LAND_STAIRS_DOWN_REACH": "You go down to the cellar.",
"LAND_STAIRS_UP": "Stairs",
"LAND_STAIRS_UP_LOOK": "The stairs down to the street. From here you can hear the van: an engine that has been idling for an hour.",
"LAND_STAIRS_UP_REACH": "You go down to the street.",
"LAND_DUILIO": "Duilio",
"LAND_DUILIO_LOOK": "Your neighbour across the landing, in a cardigan, holding a cup. He is the only person in the building who does not look like a man with a problem.",
"CELLAR_STAIRS": "Stairs",
"CELLAR_STAIRS_LOOK": "The stairs back up to the landing. From down here the building feels a great deal heavier than it looks from outside.",
"CELLAR_STAIRS_REACH": "You go back up to the landing.",
"CELLAR_MANIFEST": "Loading manifest",
"CELLAR_MANIFEST_LOOK": "A large sheet pinned up with four drawing pins. It is the list of what goes on the van, and somebody consults it often: the corners are black with fingers.",
"CELLAR_MANIFEST_LOOK_READ": "The loading manifest. File 41/9-C: your building, with all its appurtenances, and a consignment number as long as a whole line.",
"CELLAR_MANIFEST_HAND": "You leave it where it is. A list taken off a wall becomes an ordinary sheet of paper, and you need this one to go on being a list.",
"CELLAR_BOXES": "Boxes waiting",
"CELLAR_BOXES_LOOK": "The boxes from the whole building, catalogued and stacked to the ceiling, waiting for the van to be done with the upper floors.",
"CELLAR_BOXES_HAND": "These are on the list too. Down here the regulations are no more flexible than upstairs: only darker.",
"CELLAR_BOXES_ACT": "You try moving one. Under it is another identical one, and under that another.",
"CELLAR_ALCOVE": "Alcove",
"CELLAR_ALCOVE_LOOK": "A brick alcove where the old meters used to be. The wooden backboards are still there, with the cables cut off flush and never removed.",
"ARCH_DOOR": "Door to the lobby",
"ARCH_DOOR_LOOK": "The door you came in by. On the other side is the lobby, which compared to in here looks like a tidy place.",
"ARCH_DOOR_REACH": "You go back to the lobby.",
"ARCH_SACKS": "Post sacks",
"ARCH_SACKS_LOOK": "Three sacks of incoming post, with their date tags still on. The oldest is three years old. None of the three has been opened.",
"ARCH_SACKS_LOOK_DONE": "The sacks, with a hole in the middle where you rummaged. The rest is post for an office that was not opening it back then either.",
"ARCH_SACKS_ACT": "You rummage in them. Reminders, circulars, a catalogue of chairs. And at the bottom an envelope with something hard in it.",
"ARCH_SACKS_HAND": "You pull out the hard envelope. Inside is a key with a tag: YARD. It is addressed to this office, and it arrived two and a half years ago.",
"ARCH_SACKS_TAKEN": "You already have the yard key. What is left in the sack is correspondence nobody will ever read.",
"ARCH_DESK": "Receipting desk",
"ARCH_DESK_LOOK": "A desk with a stamp, a dry ink pad, and a pen on a chain too short to reach the paper.",
"ARCH_DESK_ACT": "You try the stamp on the back of your hand. It leaves nothing: the pad has been dry since before you moved in.",
"ARCH_DESK_SIGNED": "You sign the receipt. The stamp, against all expectation, works: under your signature a date and a time appear, printed crooked. It is now on record that you have been notified, and it is the first thing on record about you in three years.",
"ARCH_TRAY": "Outgoing tray",
"ARCH_TRAY_LOOK": "The outgoing tray, with a stack of sheets a hand deep on it. All of them certificates, all filled in, all going nowhere.",
"ARCH_TRAY_REFUSED": "You pick one up and put it back down. While the line is blocked these go nowhere, and carrying them about is not the same as posting them.",
"ARCH_TRAY_HAND": "You take the whole stack. Three years of certificates, tied with string, and not one of them knows yet that it is late.",
"YARD_DOOR": "Gallery door",
"YARD_DOOR_LOOK": "The fire door you came out by. On this side it has no handle, which is the kind of thing nobody checks until it matters.",
"YARD_DOOR_REACH": "You go back into the gallery.",
"YARD_FLANGES": "Line joints",
"YARD_FLANGES_LOOK": "Out here the line runs outside, on brackets, with a joint every couple of yards. Every joint has a numbered plate.",
"YARD_FLANGES_LOOK_READ": "The frost stops at the third joint. After that the pipe is dry and mild: nothing has gone through in there for a long time.",
"YARD_FLANGES_LOOK_CLEAR": "The frost now runs the whole length of the line, and the pipe is cold from end to end. It makes a thin noise, like something breathing.",
"YARD_FLANGES_ACT": "You do not touch them. You are the public in the yard as well: the rule does not change because you came out of the back door.",
"YARD_GATE": "Gate",
"YARD_GATE_LOOK": "The gate onto the back of the block. It is shut with a chain and a padlock, and the padlock is newer than the gate.",
"YARD_GATE_ACT": "The chain has one turn too many on it. Whoever locked it did not want to risk misremembering.",
"YARD_GATE_REACH": "Beyond it is the back of the block, and the back of the block is another district. You are not getting there today.",
"BAR_DOOR": "Bar door",
"BAR_DOOR_LOOK": "The door of the bar, frosted glass and a net curtain. From inside, the street is an orange smear.",
"BAR_DOOR_REACH": "You go out into the alley.",
"BAR_DOOR_LOCKED": "You have signed. Now you stay until it is over: walking out while a man is gathering up his papers is the thing you do not do.",
"BAR_CLOCK": "Clock",
"BAR_CLOCK_LOOK": "The bar clock, above the counter. It says midnight and a bit, and there is nothing else in this room that says what time it is.",
"BAR_CLOCK_LOOK_KNOWN": "The clock is seven minutes fast. Since when, nobody knows. As of tonight, it matters.",
"BAR_COUNTER": "Counter",
"BAR_COUNTER_LOOK": "A polished wooden counter, worn through in the middle where for thirty years people have put their elbows in exactly the same place.",
"BAR_COUNTER_ACT": "You put your elbows on it too. It is the most comfortable place you have been today, which is not a strong field.",
"BAR_PAPERS": "Duilio's papers",
"BAR_PAPERS_LOOK": "Three sheets open on the counter, with a box at the foot and above the box a line: SIGNATURE OF WITNESS, RESIDENT.",
"BAR_PAPERS_LOOK_SIGNED": "The papers, with your name at the bottom. Now that you look at them calmly, you see the rest as well: the destination is a code, and the time is in eleven minutes.",
"BAR_PAPERS_HAND": "They are not yours. Touching somebody else's papers is exactly the sort of thing this day has been punishing you for since the morning.",
"BAR_DUILIO": "Duilio",
"BAR_DUILIO_LOOK": "Duilio at the counter, no cardigan, same cup. Three sheets in front of him and the face of a man who has already decided.",
"STREET_ALLEY_LOCKED": "The alley leads to the bar, and the bar opens in the evening. Right now there is only a shutter and the sound of the van behind you.",
"LOBBY_ARCHIVE_DOOR": "Understairs door",
"LOBBY_ARCHIVE_DOOR_LOOK": "A low door under the stairs, ajar. Above it: ARCHIVE, with one letter somebody corrected and then gave up on.",
"LOBBY_ARCHIVE_DOOR_REACH": "You go into the understairs room.",
"TUBES_YARD_DOOR": "Yard door",
"TUBES_YARD_DOOR_LOOK": "A service door at the end of the gallery, with a lock and no handle. It gives onto the yard, where the line runs in the open.",
"TUBES_YARD_DOOR_REACH": "You go out into the yard.",
"TUBES_YARD_DOOR_LOCKED": "It is locked. The keyhole is clean, so the key exists: you simply do not have it.",
"STATION_LOG_NOT_YET": "You open the register at the first free line and stop. Every line wants a protocol number before anything else, and you do not have one.",
"STATION_CONSOLE_ACT": "You start the purge. The terminal asks at which point of the section, and you do not know: from in here the line is a pipe going into a wall.",
"ITEM_BACKYARD_KEY": "Yard key",
"ITEM_BACKYARD_KEY_LOOK": "A key with a cardboard tag: YARD. It was posted to this office two and a half years ago and nobody ever took it out of the envelope.",
"ITEM_NOTIFICATION": "Notification of occupancy",
"ITEM_NOTIFICATION_LOOK": "The notification: it declares that the property under file 41/9-C is occupied. At the foot, the receipt to tear off and sign.",
"ITEM_BACKLOG": "Backlog",
"ITEM_BACKLOG_LOOK": "Three years of occupancy certificates, tied with string. Each one says somebody lives somewhere, and not one of them has ever left the building.",
"SEQ_CELLAR_MANIFEST_1": "The manifest runs to three columns. You look for your building and find it at once, because it is at the top: file 41/9-C.",
"SEQ_CELLAR_MANIFEST_2": "Beside it is the consignment number. Eleven digits long, and it is not the building's number: it is the number of the load the building is part of.",
"SEQ_YARD_FROST_1": "Out here the line is furred with frost, because cold air is going through it at speed. You follow it with your eyes.",
"SEQ_YARD_FROST_2": "The frost stops dead after the third joint. From there on the pipe is dry: the air gets that far and no further. The joint carries a number, and the number is twelve.",
"SEQ_BAR_CLOCK_1": "The bar clock says seven minutes past midnight. You take out the receipt and look at the time printed under your signature.",
"SEQ_BAR_CLOCK_2": "Eleven fifty-one. It took you two minutes to get here from the alley. The bar clock is seven minutes fast, and tonight seven minutes is everything you have.",
"SEQ_LOBBY_RULES_1": "You read the regulations all the way to the bottom, which is a thing nobody does.",
"SEQ_LOBBY_RULES_2": "CLAUSE 9: protocol numbering is sequential within each financial year and restarts at one when each year opens. You make a note of it, without knowing yet why.",
"SEQ_PURGE_1": "You key in section 4, joint twelve. The terminal thinks about it for longer than a machine ought to.",
"SEQ_PURGE_2": "Then it opens all three valves at once, and something happens inside the wall that is not a noise but a shove.",
"SEQ_PURGE_3": "Silence. Then the red lamp goes out and a green one is left that you have never seen lit. The line is clear from end to end.",
"SEQ_END_1": "Duilio counts down the lines with his finger, reaches your signature, and stops a second longer than he needs to.",
"SEQ_END_2": "\"Thank you.\" He folds the three sheets into quarters, puts them in his cardigan pocket and finishes the cup standing up.",
"SEQ_END_3": "At the door he turns. \"I would say come along, but there is no room for two and you are on record somewhere now.\" Then he is gone.",
"SEQ_END_4": "Outside a low sound starts that is not an engine. It goes on for a long time. The glasses on the counter touch each other without anybody having moved them.",
"SEQ_END_5": "Then the noise of a shutter — enormous, very slow, and not the bar's.",
"SEQ_END_6": "And then nothing. A room with you in it, and beyond the frosted glass no orange smear at all. You look at the clock: nine minutes past midnight. Which is two minutes past.",
"DLG_DUILIO_START": "\"Morning. They have given you the sheet as well, I see.\"",
"DLG_DUILIO_OPT_CALM": "You seem calm.",
"DLG_DUILIO_REPLY_CALM": "\"I stopped being agitated three weeks ago, when I worked out it did not help. It was a relief. Recommended.\"",
"DLG_DUILIO_OPT_WITNESS": "What are you going to do?",
"DLG_DUILIO_REPLY_WITNESS": "\"Leave. I have a berth on something that is leaving. I need a witness to sign the papers, and the witness has to be resident here.\" He looks at you. \"You are.\"",
"DLG_DUILIO_OPT_WHEN": "When would you need it?",
"DLG_DUILIO_REPLY_WHEN": "\"Tonight, at the bar down the alley. Not before: the papers are not signed at the other end yet.\" He drinks. \"And not after midnight, for the reason you can guess.\"",
"DLG_DUILIO_OPT_NOTICE": "Have you read the sheet?",
"DLG_DUILIO_REPLY_NOTICE": "\"Three times. The third time I noticed it never once says the word home. It says property, appurtenance, surface. Those are words you can move.\"",
"DLG_DUILIO_OPT_BYE": "I have to go.",
"DLG_DUILIO_REPLY_BYE": "\"Go on, go on. I have all day.\"",
"DLG_BAR_START": "\"There you are. I was starting to think you had had a day.\"",
"DLG_BAR_OPT_WHAT": "I have had a day.",
"DLG_BAR_REPLY_WHAT": "\"I can tell from the box.\" He points at the papers. \"It only needs a signature. Yours.\"",
"DLG_BAR_OPT_SIGN": "I will sign.",
"DLG_BAR_REPLY_SIGN": "\"The witness has to be resident.\" He nods at the clock. \"And according to that thing you stopped being one nine minutes ago. I am genuinely sorry.\"",
"DLG_BAR_OPT_CLOCK": "That clock is fast.",
"DLG_BAR_CLOCK": "Duilio looks at the clock, then at you. \"It has been fast since I started coming here. That is not evidence, that is a habit.\"",
"DLG_BAR_OPT_SHOW": "This receipt is twenty minutes old and the time is printed on it.",
"DLG_BAR_REPLY_SHOW": "He compares the two numbers twice. Then he turns the papers towards you and puts the pen in your hand. \"A document against a clock.\" You sign. \"Since when do you win these?\"",
"DLG_BAR_OPT_NOT_YET": "Never mind.",
"DLG_BAR_OPT_BYE": "I will be right back.",
"DLG_BAR_REPLY_BYE": "\"Be quick. I am in no hurry, but that thing is.\" He points at the clock.",
"DLG_CONSOLE_OPT_NUMBER": "What protocol number am I supposed to use?",
"DLG_CONSOLE_NUMBER": "THE NUMBER IS PRINTED BY THE NUMBERING MACHINE. THE NUMBERING MACHINE IS DOWNSTREAM OF THE LINE. YOU WILL HAVE TO DEDUCE IT. I SAY THIS AS THOUGH IT WERE NORMAL.",
"DLG_CONSOLE_OPT_N_NEXT": "One after the last one written?",
"DLG_CONSOLE_REPLY_N_NEXT": "IF YOU KNEW THE RULE YOU WOULD NOT BE ASKING ME. THE RULE IS POSTED IN THE LOBBY, WHERE I CANNOT GO AND NEITHER CAN YOU.",
"DLG_CONSOLE_OPT_N_ONE": "One.",
"DLG_CONSOLE_REPLY_N_ONE": "ONE. BECAUSE THE NUMBERING RESTARTS EACH FINANCIAL YEAR AND NOBODY HAS LOGGED ANYTHING FOR THREE OF THEM. IT IS THIS YEAR'S FIRST ACT AND IT IS NOVEMBER.",
"DLG_CONSOLE_OPT_N_GUESS": "Let us say four thousand and twelve.",
"DLG_CONSOLE_REPLY_N_GUESS": "NO. AND THANK YOU FOR TRYING WITH SUCH CONFIDENCE.",
"DLG_CONSOLE_OPT_N_BACK": "Hold on.",
"DLG_CONSOLE_OPT_PURGE": "Is the line clear now?",
"DLG_CONSOLE_REPLY_PURGE": "NO. I REVERSED IT, I DID NOT PURGE IT. SECTION 4 IS STILL SHUT AND WHILE IT IS SHUT THIS OFFICE RECEIVES AND DOES NOT SEND. A PURGE NEEDS THE EXACT POINT.",
"DLG_CONSOLE_OPT_EMIT": "Issue the notification for file 41/9-C.",
"DLG_CONSOLE_REPLY_EMIT": "ISSUED. IT IS THE FIRST DOCUMENT THIS OFFICE HAS PRODUCED IN THREE YEARS AND I DO NOT APPEAR TO FEEL ANYTHING. DELIVER IT BY HAND: THE ADDRESS IS RECORDED AS IN MOTION.",
"DLG_CONSOLE_OPT_SENT": "The notification is issued.",
"DLG_CONSOLE_REPLY_SENT": "YES. NOW IT HAS TO BE DELIVERED, AND A DELIVERY IS NOT ONE UNTIL SOMEBODY SIGNS. DO NOT LOOK AT ME.",
"DLG_CONSOLE_OPT_FILE": "Issue the notification.",
"DLG_CONSOLE_REPLY_FILE": "FOR WHICH FILE. AN ADDRESS IS NOT ENOUGH: I NEED THE CONSIGNMENT NUMBER OF THE LOAD THE PROPERTY WAS PUT INTO. IT IS ON THE REMOVERS' MANIFEST, WHICH IS NOT ONE OF OUR DOCUMENTS."
}
