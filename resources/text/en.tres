[gd_resource type="Resource" script_class="LocaleTexts" load_steps=2 format=3 uid="uid://baggatexten001"]

[ext_resource type="Script" path="res://scripts/text/locale_texts.gd" id="1_texts"]

[resource]
script = ExtResource("1_texts")
locale = "en"
entries = {
"CHAR_PLAYER": "Tizio",
"CHAR_PLAYER2": "Caio",
"COMBO_STICKER_BUTTON": "You peel the sticker off and stick it on the button. The button now says DO NOT STACK.",
"DLG_CLERK_FORM": "Here is the 12-B. Fill it in in duplicate and hand in three copies.",
"DLG_CLERK_OPT_BACK": "Very well.",
"DLG_CLERK_OPT_BYE": "Goodbye.",
"DLG_CLERK_OPT_FORM": "I need form 12-B.",
"DLG_CLERK_OPT_LOOP": "But the counter is closed.",
"DLG_CLERK_OPT_STICKER": "Next door, somebody peeled a sticker off a crate.",
"DLG_CLERK_OPT_THIRD": "And the third copy?",
"DLG_CLERK_REPLY_BYE": "Counter closed.",
"DLG_CLERK_REPLY_LOOP": "Precisely. I see you have done your reading.",
"DLG_CLERK_REPLY_STICKER": "That was a safety sticker. The crate is now unsafe, and that concerns you.",
"DLG_CLERK_REPLY_THIRD": "You keep the third one, to remind you of the other two.",
"DLG_CLERK_START": "Counter closed. To open it you need form 12-B, which is collected at the counter.",
"GENERIC_COMBINE_REFUSAL": "Together they do absolutely nothing.",
"GENERIC_DOOR_CLOSE": "You close the door.",
"GENERIC_DOOR_OPEN": "You open the door.",
"GENERIC_ITEM_REFUSAL": "That has nothing to do with this.",
"GENERIC_PASSAGE_EMPTY": "There is nothing in there, for now.",
"GENERIC_PASSAGE_POSTED": "It vanishes to the other side.",
"GENERIC_PASSAGE_TAKE": "You take %s.",
"GENERIC_REFUSAL": "That does not strike me as a good idea.",
"ITEM_BUTTON": "Button",
"ITEM_BUTTON_LOOK": "A grey button, detached from everything. Pressing it now does nothing, but it does nothing with great conviction.",
"ITEM_FORM": "Form 12-B",
"ITEM_FORM_LOOK": "A form 12-B. Under «reason for the request» it says, in print, «see next entry». There is no next entry.",
"ITEM_LABELLED_BUTTON": "Labelled button",
"ITEM_LABELLED_BUTTON_LOOK": "A button that says DO NOT STACK. It is not clear what pressing it would do, and that is precisely the point.",
"ITEM_STICKER": "Sticker",
"ITEM_STICKER_LOOK": "A sticker that says DO NOT STACK. The back is still tacky, which makes it a transferable opinion.",
"MENU_LOAD": "Load",
"MENU_QUIT": "Quit",
"MENU_SETTINGS": "Settings",
"MENU_LOAD_AUTO": "Load the last autosave",
"MENU_NEW_GAME": "New game",
"MENU_SAVE": "Save",
"SETTINGS_LANGUAGE": "Language",
"SETTINGS_MUSIC": "Music: %d%%",
"SETTINGS_SOUND": "Sound: %d%%",
"SETTINGS_TITLE": "Settings",
"TITLE_CONTINUE": "Continue",
"ROOM_HALL_CLERK": "Clerk",
"ROOM_HALL_CLERK_LOOK": "A clerk behind a counter that is not there, standing as though it were.",
"ROOM_HALL_DISPENSER": "Vending machine",
"ROOM_HALL_DISPENSER_ACT": "You press the buttons one after another. The machine hums, goes out, comes back on and is exactly as it was.",
"ROOM_HALL_DISPENSER_HAND": "You press a button at random. The machine lights up, hums, and gives you the button back.",
"ROOM_HALL_DISPENSER_LOOK_ANNOYED": "The machine is on and doing nothing. From here it looks like a very active way of standing still.",
"SEQ_DISPENSER_END": "The machine goes out. Then it comes back on, humming a note higher than before.",
"ROOM_HALL_DISPENSER_LOOK": "A vending machine. Seven buttons, all with the same unreadable label.",
"ROOM_HALL_DISPENSER_TAKEN": "The other six buttons stay where they are. They look closer together than before.",
"ROOM_HALL_DOOR": "Door",
"ROOM_HALL_DOOR_CLOSE": "You close the door. On the other side, you imagine, nobody notices.",
"ROOM_HALL_DOOR_LOOK": "The door you came in by. On this side nothing is written on it.",
"ROOM_HALL_DOOR_OPEN": "You open the door. On this side the hinges are more polite.",
"ROOM_HALL_DOOR_REACH": "You go back in. The room has not moved.",
"ROOM_HALL_FARDOOR": "Far door",
"ROOM_HALL_FARDOOR_LOOK": "Another door, at the end of the corridor. Above it, an arrow pointing at the door itself.",
"ROOM_HALL_FARDOOR_REACH": "You go through the far door. The corridor beyond is a great deal longer than this one.",
"ROOM_LONG_DOOR": "Door",
"ROOM_LONG_DOOR_LOOK": "The door you came in by. From this side it looks further away than it is.",
"ROOM_LONG_DOOR_REACH": "You go back, and the corridor shortens all at once.",
"ROOM_LONG_WINDOW": "Window",
"ROOM_LONG_WINDOW_LOOK": "A window. Outside there is another corridor, with a window in it.",
"ROOM_HALL_SIGN": "Sign",
"ROOM_HALL_SIGN_ACCEPTED": "You stick the button under the writing. The sign now says LEVEL 4, DO NOT STACK: it looks a great deal less like information.",
"ROOM_HALL_SIGN_ACT": "You pull the sign towards you. It is screwed to the wall. Very screwed.",
"ROOM_HALL_SIGN_LOOK": "A sign: LEVEL 4. Somebody crossed out the 4 and wrote 4 again, more firmly.",
"ROOM_HALL_SIGN_REACH": "The sign does not answer. It goes on insisting that it is level 4.",
"ROOM_HALL_SLOT": "Slot",
"ROOM_HALL_SLOT_HAND": "There is nothing inside. The plate goes on saying COLLECTION, undeterred.",
"ROOM_HALL_SLOT_LOOK": "The same slot, from this side. Here the plate says FORMS (COLLECTION).",
"ROOM_HALL_SLOT_POSTED": "You push it into the slot. There is a thud on the other side, then silence.",
"ROOM_HALL_SLOT_WAITING": "There is something in the slot that was not there before.",
"ROOM_TEST_CRATE": "Crate",
"ROOM_TEST_CRATE_ACT": "You push the lid with both hands. The crate moves a centimetre and puts itself back.",
"ROOM_TEST_CRATE_HAND": "The lid does not give a millimetre. The sticker, on the other hand, comes straight off.",
"ROOM_TEST_CRATE_LOOK": "A metal crate. A sticker on the lid says DO NOT STACK.",
"ROOM_TEST_CRATE_LOOK_PEELED": "A metal crate. Where the sticker was the grey is lighter, and the crate has stopped having opinions about stacking.",
"ROOM_TEST_CRATE_TAKEN": "A cleaner rectangle is left on the lid, telling nobody anything.",
"ROOM_TEST_DOOR": "Door",
"ROOM_TEST_DOOR_CLOSE": "You close the door. The hinges repeat the same sentence backwards.",
"ROOM_TEST_DOOR_LOOK": "A door. EXIT is written above it, but the arrow points downwards.",
"ROOM_TEST_DOOR_OPEN": "You open the door. The hinges protest in a language you do not know.",
"ROOM_TEST_DOOR_REACH": "You go through the door. There is a corridor beyond, which is already information.",
"ROOM_TEST_DRAFT": "Draught",
"ROOM_TEST_DRAFT_LOOK": "Warm air comes through the open door, smelling of carpet and of service announcements.",
"ROOM_TEST_SLOT": "Slot",
"ROOM_TEST_SLOT_HAND": "You push your hand in up to the wrist. Inside there is only wall.",
"ROOM_TEST_SLOT_LOOK": "A slot in the wall, at chest height. Below it, an enamelled plate: FORMS.",
"ROOM_TEST_SLOT_POSTED": "You push it into the slot. There is a thud on the other side, then silence.",
"ROOM_TEST_SLOT_WAITING": "Something is sticking out of the slot. Somebody posted it from the other side.",
"UI_BAG": "Bag",
"UI_EMPTY_BAG": "You are not carrying anything.",
"UI_LOADED": "Game loaded.",
"UI_LOAD_FAILED": "This saved game cannot be read.",
"UI_MENU": "Menu",
"UI_NOTHING_TO_LOAD": "There is nothing to load.",
"UI_SAVED": "Game saved.",
"UI_SAVE_FAILED": "The game could not be saved.",
"UI_USING": "Use %s with...",
"VERB_CLOSE": "Close",
"VERB_GO": "Go",
"VERB_LOOK": "Look",
"VERB_OPEN": "Open",
"VERB_TAKE": "Take",
"VERB_TALK": "Talk",
"VERB_USE": "Use"
}
