[gd_resource type="Resource" script_class="LocaleTexts" load_steps=2 format=3 uid="uid://baggatextit001"]

[ext_resource type="Script" path="res://scripts/text/locale_texts.gd" id="1_texts"]

[resource]
script = ExtResource("1_texts")
locale = "it"
entries = {
"INTRO_ORDER_HEADING": "ORDINE DI RITIRO",
"INTRO_ORDER_AUTHORITY": "Servizio Traslochi e Giacenze — Sezione Ritiri Programmati",
"INTRO_ORDER_ARTICLE": "Visto l'articolo 12, comma 3 (presunzione di non occupazione)",
"INTRO_ORDER_MISSING": "Vista l'assenza agli atti del certificato di occupazione",
"INTRO_ORDER_TERM": "Decorsi i tre anni previsti, e nessuno avendo scritto",
"INTRO_ORDER_ORDERS": "SI ORDINA IL RITIRO DELL'IMMOBILE E DI OGNI SUA PERTINENZA",
"INTRO_ORDER_CLAUSE": "Si rammenta che gli immobili viaggiano e i residenti no.",
"INTRO_ORDER_SIGNED": "Firma del funzionario incaricato: illeggibile",
"INTRO_ORDER_SUBJECT": "Oggetto del ritiro: settore 9, distretto 41, corpo 3, superficie abitata, via dei Tessitori 14.",
"SEQ_INTRO_ARRIVE": "Torni a casa alle sette e dieci, come ogni mattina.",
"SEQ_INTRO_VAN": "Il furgone ieri non c'era. E qualcuno sta caricando una cosa che somiglia molto al divano del pianerottolo.",
"SEQ_INTRO_NOTICE": "Sul portone c'è un foglio. Sul portone non c'è mai stato niente.",
"STREET_DOOR": "Portone",
"STREET_DOOR_LOOK": "Il portone di casa tua. Oggi è aperto, cosa che non succede mai, e il motivo sta scendendo le scale con un armadio.",
"STREET_DOOR_ACT": "È già aperto. Lo tengono aperto loro, con un cuneo di gomma che non è tuo.",
"STREET_DOOR_REACH": "Sali. Le scale sono ancora le tue, e lo saranno fino a mezzanotte.",
"STREET_NOTICE": "Avviso",
"STREET_NOTICE_LOOK": "AVVISO DI RITIRO. L'immobile sarà prelevato. Per opposizioni rivolgersi all'ufficio competente entro il termine indicato. Il termine non è indicato.",
"STREET_NOTICE_HAND": "Lo stacchi a metà e ti fermi. Staccare un avviso è già un'opposizione, e le opposizioni si fanno all'ufficio.",
"STREET_BINS": "Bidoni",
"STREET_BINS_LOOK": "Due bidoni. A uno il coperchio non chiude per via di qualcosa che non è spazzatura: è la lampada del pianerottolo, e ha ancora la lampadina.",
"STREET_BINS_ACT": "Sollevi il coperchio. Dentro c'è mezzo pianerottolo, buttato con una certa fretta.",
"STREET_VAN": "Furgone",
"STREET_VAN_LOOK": "Un furgone da trasloco, in retromarcia contro la saracinesca del deposito. Sulla fiancata c'è un pannello dove dovrebbe stare il nome della ditta. Non c'è.",
"STREET_VAN_ACT": "Non si tocca il furgone degli altri. È una regola che ti sei dato oggi, adesso, guardandolo.",
"STREET_VAN_REACH": "In cabina non c'è nessuno. Le voci vengono da dentro il portone, e vanno verso l'alto.",
"STREET_BARRIER": "Sbarra",
"STREET_BARRIER_LOOK": "Una sbarra a strisce attraverso la via, con un palo da una parte e una gamba dall'altra. Di là la strada continua identica, il che la rende più irritante e non meno.",
"STREET_BARRIER_ACT": "È chiusa con un lucchetto e un pezzo di fil di ferro, in quest'ordine di importanza.",
"STREET_BARRIER_REACH": "Ti chini e passi sotto. La via, di là, è una via qualunque.",
"STREET_ALLEY": "Vicolo",
"STREET_ALLEY_LOOK": "Il vicolo fra casa tua e il deposito. Ci sta esattamente un gatto, e infatti ce n'è uno, e ti guarda come se sapesse.",
"STREET_ALLEY_REACH": "Entri per due passi. Poi c'è un muro, e sul muro qualcuno ha scritto un numero di pratica.",
"STREET_BELLS": "Campanelli",
"STREET_BELLS_LOOK": "Quattro campanelli. Tre hanno un nome. Il quarto ha un pezzo di nastro adesivo con sopra lo stesso nome di prima, cancellato.",
"STREET_BELLS_ACT": "Suoni il tuo. Suona a casa tua, e lo senti benissimo dalla strada, cosa che fino a ieri non succedeva.",
"STREET_DRAIN": "Tombino",
"STREET_DRAIN_LOOK": "Un tombino. Sotto scorre qualcosa che si sente e non si vede, come quasi tutto in questa faccenda.",
"STREET_DRAIN_HAND": "Le dita entrano nella griglia fino alla seconda falange e trovano acqua. Ritiri le dita.",
"LOBBY_DOOR_LOOK_OPEN": "La porta è aperta, e dal corridoio entra una lama di luce che si allarga sul pavimento fin quasi alle sedie.",
"TUBES_DOOR_LOOK_OPEN": "La porta è spalancata sull'atrio. Da qui si vede il pavimento di là: lo stesso grigio, ma con l'aria di essersene accorto.",
"STATION_LEVER_ACT_DONE": "La leva è già giù. La linea gira al contrario e nessuno le ha chiesto fino a quando.",
"CHAR_LINO": "Lino",
"CHAR_CESARE": "Cesare",
"ITEM_FORM_BLANK": "Modulo di reclamo",
"ITEM_FORM_BLANK_LOOK": "Un modulo di reclamo, vuoto. Alla voce «sezione interessata» c'è un riquadro con scritto: riportare la targhetta in originale.",
"ITEM_PLATE": "Targhetta SEZIONE 4",
"ITEM_PLATE_LOOK": "Una targhetta smaltata che dice SEZIONE 4. Era avvitata sotto l'oblò, con una vite sola e già mezza fuori.",
"ITEM_FORM_FILLED": "Reclamo compilato",
"ITEM_FORM_FILLED_LOOK": "Il modulo con la targhetta appiccicata dentro il riquadro. In originale, come richiesto.",
"ITEM_CERTIFICATE": "Certificato di occupazione",
"ITEM_CERTIFICATE_LOOK": "Il certificato che dice che a questi indirizzi abita qualcuno. Data di spedizione: tre anni fa. Data di consegna: un riquadro vuoto. In fondo c'è l'elenco degli indirizzi certificati, e il tuo è l'ultimo.",
"COMBO_FORM_PLATE": "Stacchi il retro della targhetta e la appiccichi nel riquadro. Il modulo adesso dice SEZIONE 4 in originale, che è esattamente quello che chiedeva.",
"LOBBY_NOTICE": "Regolamento",
"LOBBY_NOTICE_LOOK": "REGOLAMENTO, COMMA 6: i reclami del pubblico viaggiano sulla linea di ritorno e vanno protocollati. COMMA 7: il personale non è pubblico. COMMA 8: il pubblico non è personale.",
"LOBBY_FORMS": "Portamoduli",
"LOBBY_FORMS_LOOK": "Un portamoduli a parete con due scomparti: RECLAMI e RECLAMI SUL PORTAMODULI. Il secondo è vuoto.",
"LOBBY_FORMS_HAND": "Prendi un modulo di reclamo dallo scomparto pieno. Sei venuto a opporti al ritiro di casa tua e ti ritrovi in mano un foglio che parla di tubature: qui funziona così, e se non funziona la tubatura non funziona niente.",
"LOBBY_FORMS_TAKEN": "Nel primo scomparto ce ne sono altri quaranta. Nel secondo continua a non esserci niente.",
"LOBBY_DOOR": "Porta del corridoio",
"LOBBY_DOOR_LOOK": "La porta verso il corridoio dei tubi. Sopra, un cartello: GALLERIA D'ISPEZIONE PUBBLICA. VIETATO TOCCARE L'IMPIANTO.",
"LOBBY_DOOR_REACH": "Entri nella galleria. Nessuno ti ferma: è pubblica, c'è scritto.",
"LOBBY_CHAIRS": "Sedie",
"LOBBY_CHAIRS_LOOK": "Quattro sedie in fila per un atrio dove non aspetta nessuno da parecchio. Su una c'è la forma di qualcuno, in polvere, e la polvere è vecchia quanto il silenzio di questo posto.",
"TUBES_PIPE": "Tubatura",
"TUBES_PIPE_LOOK": "La posta pneumatica corre lungo tutto il muro e si perde in fondo. È l'unico modo che questo ufficio ha di spedire quello che certifica.",
"TUBES_PIPE_ACT": "Allunghi la mano e la ritiri. Sei pubblico, e il pubblico l'impianto non lo tocca: è la prima riga del cartello e l'unica scritta grande.",
"TUBES_PORTHOLE": "Oblò d'ispezione",
"TUBES_PORTHOLE_LOOK": "Dentro l'oblò c'è una capsula ferma di traverso. Sotto, una targhetta: SEZIONE 4.",
"TUBES_PORTHOLE_LOOK_CLEAR": "Dentro l'oblò non c'è più niente, e il vetro è pieno di polvere che prima era da qualche altra parte.",
"TUBES_PORTHOLE_ACT": "L'oblò si apre solo dall'interno dell'impianto, e all'impianto tu non puoi arrivare da nessuna parte.",
"TUBES_PLATE": "Targhetta",
"TUBES_PLATE_LOOK": "SEZIONE 4, avvitata sotto l'oblò con una vite sola. La segnaletica non è impianto: su questo il regolamento è chiarissimo.",
"TUBES_PLATE_HAND": "Sviti la targhetta con l'unghia. La segnaletica non è impianto, e questa è una distinzione che oggi ti salva la giornata.",
"TUBES_POINT": "Punto d'imbucata",
"TUBES_POINT_LOOK": "Il punto d'imbucata pubblico. Una bocca di ottone e sopra, a lettere piccole: PUBBLICO. Quello che imbuchi qui esce dalla parte del personale, e dalla parte del personale qualcuno c'è.",
"TUBES_POINT_HAND": "Dentro non c'è niente. La linea di ritorno funziona: è l'andata che è ferma alla sezione 4.",
"TUBES_POINT_POSTED": "Imbuchi. Un soffio se lo porta via, e per la prima volta oggi qualcosa in questo posto si muove. Dall'altra parte, adesso, c'è qualcuno che ha qualcosa da fare.",
"TUBES_POINT_WAITING": "Dalla bocca di ottone spunta qualcosa. Qualcuno dall'altra parte ha imbucato.",
"TUBES_DOOR": "Porta dell'atrio",
"TUBES_DOOR_LOOK": "La porta da cui sei entrato. Da questo lato non c'è nessun cartello, il che è una posizione.",
"TUBES_DOOR_REACH": "Torni nell'atrio.",
"TUBES_CAPSULE": "Capsula",
"TUBES_CAPSULE_LOOK": "La capsula che era ferma alla sezione 4. È uscita dal punto pubblico con un tonfo e adesso sta lì, ammaccata e paziente.",
"TUBES_CAPSULE_HAND": "Apri la capsula. Dentro c'è un foglio solo, e lo leggi due volte.",
"STATION_CONSOLE": "Console",
"STATION_CONSOLE_LOOK": "La console della posta pneumatica. Una spia rossa, una leva, e un terminale che risponde a chi glielo chiede.",
"STATION_LEVER": "Leva d'inversione",
"STATION_LEVER_LOOK": "La leva che manda la linea al contrario. Sopra, un'etichetta: SOLO CON MOTIVO PROTOCOLLATO.",
"STATION_LEVER_ACT": "Tiri la leva. La leva non si muove: senza un motivo protocollato è solo un pezzo di ottone attaccato al muro.",
"STATION_LOG": "Registro",
"STATION_LOG_LOOK": "Il registro dei motivi. L'ultima riga è di tre anni fa e dice: nessun motivo.",
"STATION_LOG_ACT": "Sfogli il registro. Righe vuote fino in fondo, tutte con la data già stampata.",
"STATION_LOG_ACCEPTED": "Protocolli il reclamo. Il registro ha una riga in più, e adesso l'inversione della linea ha un motivo.",
"STATION_POINT": "Bocchetta di servizio",
"STATION_POINT_LOOK": "La bocchetta di servizio, dove arriva quello che il pubblico imbuca. Non ci arriva niente da tre anni.",
"STATION_POINT_HAND": "Vuota. Come da tre anni a questa parte.",
"STATION_POINT_POSTED": "Imbuchi. Parte, e speri che dall'altra parte ci sia qualcuno.",
"STATION_POINT_WAITING": "Nella bocchetta c'è qualcosa. Qualcosa. Nella bocchetta.",
"DLG_CONSOLE_START": "TERMINALE PRONTO. LINEA OSTRUITA. NON CHIEDA DOVE.",
"DLG_CONSOLE_OPT_WHERE": "Dove è ostruita?",
"DLG_CONSOLE_REPLY_WHERE": "GLIEL'HO DETTO DI NON CHIEDERE. IL TERMINALE NON VEDE L'INTERNO DELLA LINEA: PER QUELLO C'È L'OBLÒ, CHE È IN CORRIDOIO.",
"DLG_CONSOLE_OPT_REVERSE": "Posso invertire la linea?",
"DLG_CONSOLE_REPLY_REVERSE": "CON UN MOTIVO PROTOCOLLATO. UN MOTIVO VALIDO È UN RECLAMO DEL PUBBLICO. LEI NON È PUBBLICO: LEI È QUI.",
"DLG_CONSOLE_OPT_COMPLAIN": "Presento io un reclamo.",
"DLG_CONSOLE_REPLY_COMPLAIN": "IL PERSONALE IMBUCA I RECLAMI NELLA BOCCHETTA DI SERVIZIO. LA BOCCHETTA DI SERVIZIO È SULLA LINEA OSTRUITA. NOTI L'ELEGANZA.",
"DLG_CONSOLE_OPT_READY": "Ho un reclamo protocollato.",
"DLG_CONSOLE_REPLY_READY": "ALLORA LA LEVA SI MUOVERÀ. LO DICO SENZA ENTUSIASMO PERCHÉ NON NE HO.",
"DLG_CONSOLE_OPT_BYE": "Va bene.",
"DLG_CONSOLE_REPLY_BYE": "TERMINALE IN ATTESA. COME SEMPRE.",
"SEQ_LEVER_PULL": "Tiri la leva, e stavolta scende.",
"SEQ_LEVER_RUMBLE": "Il tubo fa un rumore che non faceva da tre anni. Qualcosa di pesante torna indietro lungo tutto il muro.",
"SEQ_LEVER_END": "Poi silenzio, e un tonfo lontano dalla parte dell'atrio.",
"GENERIC_COMBINE_REFUSAL": "Insieme non fanno assolutamente niente.",
"GENERIC_DOOR_CLOSE": "Chiudi la porta.",
"GENERIC_DOOR_OPEN": "Apri la porta.",
"GENERIC_ITEM_REFUSAL": "Non c'entra niente con questo.",
"GENERIC_PASSAGE_EMPTY": "Non c'è niente, per ora.",
"GENERIC_PASSAGE_POSTED": "Sparisce dall'altra parte.",
"GENERIC_PASSAGE_TAKE": "Prendi %s.",
"GENERIC_REFUSAL": "Non mi sembra il caso.",
"MENU_LOAD": "Carica",
"MENU_QUIT": "Esci",
"MENU_SETTINGS": "Impostazioni",
"MENU_LOAD_AUTO": "Carica l'ultimo automatico",
"MENU_NEW_GAME": "Nuova partita",
"MENU_SAVE": "Salva",
"SETTINGS_LANGUAGE": "Lingua",
"SETTINGS_MUSIC": "Musica: %d%%",
"SETTINGS_SOUND": "Effetti: %d%%",
"SETTINGS_TITLE": "Impostazioni",
"TITLE_CONTINUE": "Continua",
"UI_BAG": "Zaino",
"UI_EMPTY_BAG": "Non hai niente.",
"UI_LOADED": "Partita caricata.",
"UI_LOAD_FAILED": "Questo salvataggio non si può leggere.",
"UI_MENU": "Menù",
"UI_NOTHING_TO_LOAD": "Non c'è niente da caricare.",
"UI_SAVED": "Partita salvata.",
"UI_SAVE_FAILED": "Non è stato possibile salvare.",
"UI_USING": "Usa %s con...",
"VERB_CLOSE": "Chiudi",
"VERB_GO": "Vai",
"VERB_LOOK": "Guarda",
"VERB_OPEN": "Apri",
"VERB_TAKE": "Prendi",
"VERB_TALK": "Parla",
"VERB_USE": "Usa",
"APT_DOOR": "Porta di casa",
"APT_DOOR_LOOK": "La porta di casa tua, tenuta aperta da un cuneo di gomma che non è tuo. Sul pianerottolo c'è più luce che qui dentro.",
"APT_DOOR_REACH": "Scendi in strada.",
"APT_BOXES": "Scatole",
"APT_BOXES_LOOK": "Le tue cose, in scatole che non hai comprato, chiuse con nastro che non hai srotolato. Su ognuna c'è un cartellino, e su ogni cartellino una riga stampata.",
"APT_BOXES_HAND": "Sollevi un lembo di nastro. L'addetto non alza la testa: «È a elenco.» Rimetti giù il lembo di nastro.",
"APT_BOXES_ACT": "Le scatole sono chiuse, e aprirle davanti a chi le ha chiuse sembra una discussione che perderesti.",
"APT_DOCBOX": "Scatola dei documenti",
"APT_DOCBOX_LOOK": "La scatola dei documenti. Non l'hai mai aperta da quando sei arrivato: c'è ancora sopra il nastro di allora, giallo, e l'etichetta di consegna con la data.",
"APT_DOCBOX_LOOK_FREE": "La scatola dei documenti, con una riga di penna sul cartellino. Adesso è soltanto una scatola.",
"APT_DOCBOX_HAND": "Te la metti sotto il braccio. Pesa come tre anni di cose che non hai guardato.",
"APT_DOCBOX_REFUSED": "Ci provi. «Quella è a elenco», dice l'addetto, senza guardare quale.",
"APT_DOCBOX_TAKEN": "Ce l'hai già sotto il braccio, ed è più ingombrante di quanto sembri.",
"APT_CLERK": "Addetto al carico",
"APT_CLERK_LOOK": "Non porta giù niente. Ha una tavoletta, una penna dietro l'orecchio, e l'aria di chi è in piedi da prima di te.",
"APT_WINDOW": "Finestra",
"APT_WINDOW_LOOK": "Da qui si vede il tetto del furgone. Ci stanno caricando qualcosa di lungo e avvolto in una coperta, e la coperta è la tua.",
"APT_WINDOW_ACT": "La apri. Entra aria fredda e il rumore di gente che lavora bene. La richiudi.",
"APT_MATTRESS": "Materasso",
"APT_MATTRESS_LOOK": "Arrotolato e legato in due punti, con i nodi fatti da qualcuno che sa fare i nodi. Non ricordi di aver dormito su un materasso arrotolato, e infatti stanotte non ci dormirai.",
"APT_MATTRESS_HAND": "Sposti il materasso di dieci centimetri. Adesso il pavimento sotto è polveroso in una forma diversa.",
"SEQ_APT_LABEL": "Sotto il nastro c'è ancora l'etichetta di consegna di quando ti sei trasferito. Data, numero, e la parola CONSEGNATO, stampata storta.",
"DLG_CLERK_START": "«Non tocchi niente, per cortesia. È tutto a elenco.»",
"DLG_CLERK_OPT_WHO": "Lei chi sarebbe?",
"DLG_CLERK_REPLY_WHO": "«Addetto al carico. Io non porto giù niente. Io spunto.»",
"DLG_CLERK_OPT_LIST": "Che cos'è questo elenco?",
"DLG_CLERK_REPLY_LIST": "«Le pertinenze dell'immobile. L'immobile parte, e le pertinenze partono con lui. Altrimenti arriva vuoto e poi sono grane.»",
"DLG_CLERK_OPT_MINE": "Ma sono cose mie.",
"DLG_CLERK_REPLY_MINE": "«Sono cose che erano dentro. È una parola diversa, e l'elenco usa quella.»",
"DLG_CLERK_OPT_STRIKE": "E se una cosa non dovesse partire?",
"DLG_CLERK_REPLY_STRIKE": "«Posso depennare solo ciò che risulta già consegnato. Una cosa già consegnata non si può ritirare: sarebbe un secondo ritiro della stessa cosa, e il secondo ritiro non è previsto.»",
"DLG_CLERK_OPT_LABEL": "Sulla scatola dei documenti c'è un'etichetta di consegna. Guardi la data.",
"DLG_CLERK_LABEL": "Va di là, si china, legge. Resta chinato un momento in più del necessario. «...Mh.»",
"DLG_CLERK_OPT_LABEL_YES": "Quindi risulta già consegnata.",
"DLG_CLERK_REPLY_LABEL_YES": "«Risulta.» Si toglie la penna da dietro l'orecchio e tira una riga sul cartellino, con il righello, perché una riga storta non vale. «Quella non è roba nostra.»",
"DLG_CLERK_OPT_LABEL_NO": "Lasci stare, non importa.",
"DLG_CLERK_OPT_THANKS": "Grazie.",
"DLG_CLERK_REPLY_THANKS": "«Non mi ringrazi. Se me ne trova un'altra come quella, la depenno anche quella, e a fine giornata mi chiedono perché il carico è leggero.»",
"DLG_CLERK_OPT_BYE": "Vado.",
"DLG_CLERK_REPLY_BYE": "«Faccia con comodo. Fino a mezzanotte è casa sua.»",
"ITEM_DOCUMENTS": "Scatola dei documenti",
"ITEM_DOCUMENTS_LOOK": "Tutto quello che dimostra che esisti, in una scatola che dimostra di essere già stata consegnata.",
"STREET_BARRIER_LOCKED": "La sbarra è bassa e chi la sorveglia è a due passi. Passarci sotto senza dire niente sarebbe la cosa più stupida della giornata, e la giornata è lunga.",
"STREET_WARDEN": "Sorvegliante",
"STREET_WARDEN_LOOK": "Pettorina, cappello, mani dietro la schiena. Non ha una tavoletta: la sua lista è appesa al palo, e lui la sa a memoria.",
"DLG_WARDEN_START": "«Zona in trasloco. Di qui passano residenti e personale. Lei?»",
"DLG_WARDEN_OPT_WHY": "Perché è chiusa?",
"DLG_WARDEN_REPLY_WHY": "«Perché quando si sposta un immobile la gente si ferma a guardare. E chi si ferma a guardare risulta presente. Poi tocca riclassificare tutto, e non è il mio ufficio.»",
"DLG_WARDEN_OPT_RESIDENT": "Sono residente.",
"DLG_WARDEN_REPLY_RESIDENT": "«Allora ha qualcosa che lo dice. Non chi è lei: dove sta.»",
"DLG_WARDEN_OPT_ID": "Ho un documento d'identità.",
"DLG_WARDEN_REPLY_ID": "«Quello dice chi è. A me serve dove. Sono due uffici diversi e non si parlano da prima che nascessi io.»",
"DLG_WARDEN_OPT_SHOW": "Guardi questa etichetta di consegna.",
"DLG_WARDEN_SHOW": "Prende la scatola, la gira verso la luce, legge. Legge una seconda volta. «È di tre anni fa.»",
"DLG_WARDEN_OPT_SHOW_YES": "Dice che a quell'indirizzo è stato consegnato qualcosa. Non dice che debba essere recente.",
"DLG_WARDEN_REPLY_SHOW_YES": "«...No. Non lo dice.» Alza la sbarra di quaranta centimetri, quanto basta a passarci chinandosi. «Rientri prima di mezzanotte. Dopo non è più residente, e non la faccio rientrare.»",
"DLG_WARDEN_OPT_SHOW_NO": "Lasci stare.",
"DLG_WARDEN_OPT_AGAIN": "Passo di nuovo.",
"DLG_WARDEN_REPLY_AGAIN": "«Ha già mostrato. Vada.»",
"DLG_WARDEN_OPT_BYE": "Vado.",
"DLG_WARDEN_REPLY_BYE": "«Rimanga di qua.»",
"LOBBY_ENTRANCE": "Ingresso",
"LOBBY_ENTRANCE_LOOK": "La porta a vetri da cui sei entrato, tenuta aperta da un fermo. Sopra, una targa: UFFICIO CERTIFICAZIONI DI OCCUPAZIONE. Il nome è più lungo della targa e le ultime due lettere sono dipinte sul muro.",
"LOBBY_ENTRANCE_REACH": "Esci in strada.",
"LAND_BELLS": "Campanelli",
"LAND_BELLS_LOOK": "Sei pulsanti e due nomi. Gli altri quattro cartellini sono stati tolti, e sotto si vede il cartoncino nuovo di quando li avevano messi.",
"LAND_BELLS_ACT": "Suoni il tuo. Il tuo campanello suona in casa tua, che è vuota, e lo senti attraverso la porta. È un rumore che non voleva dire niente e adesso vuol dire qualcosa.",
"LAND_METERS": "Vano contatori",
"LAND_METERS_LOOK": "Lo sportello dei contatori, con la vernice che si stacca a scaglie. Sopra, un adesivo scolorito di una società che non esiste più.",
"LAND_METERS_ACT": "Dentro ci sono tre contatori e una busta. La busta è per l'inquilino del secondo, che se n'è andato prima che tu arrivassi.",
"LAND_FLAT_DOOR": "Porta di casa tua",
"LAND_FLAT_DOOR_LOOK": "La tua porta, con l'avviso di ritiro incollato al centro. È lo stesso foglio del portone, stampato più piccolo, e col nastro messo dalla stessa mano.",
"LAND_FLAT_DOOR_REACH": "Entri in casa.",
"LAND_DUILIO_DOOR": "Porta di Duilio",
"LAND_DUILIO_DOOR_LOOK": "La stessa porta della tua, con un cartone appeso al posto dell'avviso. Sul cartone c'è scritto VUOTO, con la calligrafia di chi l'ha scritto per sé e non per gli altri.",
"LAND_DUILIO_DOOR_ACT": "È aperta e dentro non c'è niente. Nemmeno le scatole: Duilio non ha aspettato che venissero a imballargli la roba.",
"LAND_STAIRS_DOWN": "Scale per la cantina",
"LAND_STAIRS_DOWN_LOOK": "Le scale che scendono in cantina. La luce sul pianerottolo di sotto è accesa, e non l'hai accesa tu.",
"LAND_STAIRS_DOWN_REACH": "Scendi in cantina.",
"LAND_STAIRS_UP": "Scale",
"LAND_STAIRS_UP_LOOK": "Le scale che portano giù in strada. Da qui si sente il furgone: un motore che gira al minimo da un'ora.",
"LAND_STAIRS_UP_REACH": "Scendi in strada.",
"LAND_DUILIO": "Duilio",
"LAND_DUILIO_LOOK": "Il tuo vicino di pianerottolo, in cardigan, con una tazza in mano. È l'unica persona nel palazzo che non ha l'aria di avere un problema.",
"CELLAR_STAIRS": "Scale",
"CELLAR_STAIRS_LOOK": "Le scale che risalgono al pianerottolo. Da qui il palazzo sembra molto più pesante di quanto sembri da fuori.",
"CELLAR_STAIRS_REACH": "Risali al pianerottolo.",
"CELLAR_MANIFEST": "Distinta di carico",
"CELLAR_MANIFEST_LOOK": "Un foglio grande appeso con quattro puntine. È l'elenco di quello che va caricato, e qualcuno lo consulta spesso: gli angoli sono neri di dita.",
"CELLAR_MANIFEST_LOOK_READ": "La distinta di carico. Pratica 41/9-C: il tuo palazzo, con tutte le sue pertinenze, e un numero di spedizione lungo come una riga intera.",
"CELLAR_MANIFEST_HAND": "Lo lasci dov'è. Un elenco staccato dal muro diventa un foglio qualunque, e questo ti serve che resti un elenco.",
"CELLAR_BOXES": "Scatole in attesa",
"CELLAR_BOXES_LOOK": "Le scatole di tutto il palazzo, catalogate e impilate fino al soffitto, in attesa che il furgone abbia finito con i piani di sopra.",
"CELLAR_BOXES_HAND": "Sono a elenco anche queste. In cantina il regolamento non è più elastico che di sopra: è solo più buio.",
"CELLAR_BOXES_ACT": "Provi a spostarne una. Sotto ce n'è un'altra identica, e sotto quella un'altra ancora.",
"CELLAR_ALCOVE": "Nicchia",
"CELLAR_ALCOVE_LOOK": "Una nicchia di mattoni dove stavano i contatori vecchi. Sono ancora lì le basi di legno, con i cavi tagliati a filo e mai tolti.",
"ARCH_DOOR": "Porta dell'atrio",
"ARCH_DOOR_LOOK": "La porta da cui sei entrato. Dall'altra parte c'è l'atrio, che rispetto a qui sembra un posto ordinato.",
"ARCH_DOOR_REACH": "Torni nell'atrio.",
"ARCH_SACKS": "Sacchi della posta",
"ARCH_SACKS_LOOK": "Tre sacchi di posta in arrivo, con i cartellini della data ancora attaccati. Il più vecchio è di tre anni fa. Nessuno dei tre è stato aperto.",
"ARCH_SACKS_LOOK_DONE": "I sacchi, con un buco in mezzo dove hai frugato. Il resto è posta per un ufficio che non la apriva già allora.",
"ARCH_SACKS_ACT": "Ci frughi dentro. Solleciti, circolari, un catalogo di sedie. E in fondo una busta con dentro qualcosa di duro.",
"ARCH_SACKS_HAND": "Tiri fuori la busta dura. Dentro c'è una chiave con un cartellino: CORTILE. È indirizzata a questo ufficio, ed è arrivata due anni e mezzo fa.",
"ARCH_SACKS_TAKEN": "La chiave del cortile ce l'hai già. Nel sacco resta solo la corrispondenza che nessuno leggerà mai.",
"ARCH_DESK": "Banco di ricezione",
"ARCH_DESK_LOOK": "Un banco con un timbro, un tampone secco e una penna legata a una catenella troppo corta per arrivare al foglio.",
"ARCH_DESK_ACT": "Provi il timbro sul dorso della mano. Non lascia niente: il tampone è secco da prima che tu venissi ad abitare qui.",
"ARCH_DESK_SIGNED": "Firmi la ricevuta. Il timbro, contro ogni previsione, funziona: sotto la tua firma compaiono la data e l'ora, stampate storte. Adesso risulta che ti è stato notificato, ed è la prima cosa che risulta di te da tre anni.",
"ARCH_TRAY": "Vassoio della posta in partenza",
"ARCH_TRAY_LOOK": "Il vassoio della posta in partenza, e sopra una pila di fogli alta un palmo. Sono tutti certificati, tutti compilati, tutti fermi.",
"ARCH_TRAY_REFUSED": "Ne prendi uno e lo rimetti giù. Finché la linea è ostruita questi non vanno da nessuna parte, e portarseli in giro non è spedirli.",
"ARCH_TRAY_HAND": "Prendi tutta la pila. Tre anni di certificati, legati con lo spago, e nessuno di loro sa ancora di essere in ritardo.",
"YARD_DOOR": "Porta della galleria",
"YARD_DOOR_LOOK": "La porta antipanico da cui sei uscito. Da questa parte non ha maniglia, il che è una cosa che nessuno controlla mai finché non serve.",
"YARD_DOOR_REACH": "Rientri nella galleria.",
"YARD_FLANGES": "Giunti della linea",
"YARD_FLANGES_LOOK": "Qui la linea corre fuori, su mensole, con un giunto ogni due metri. Ogni giunto ha una targhetta con un numero.",
"YARD_FLANGES_LOOK_READ": "La brina si ferma al terzo giunto. Dopo, il tubo è asciutto e tiepido: là dentro non passa niente da un pezzo.",
"YARD_FLANGES_LOOK_CLEAR": "La brina adesso arriva fino in fondo alla linea, e il tubo è freddo per tutta la sua lunghezza. Fa un rumore sottile, come qualcosa che respira.",
"YARD_FLANGES_ACT": "Non li tocchi. Sei pubblico anche in cortile: la regola non cambia perché sei uscito dalla porta di dietro.",
"YARD_GATE": "Cancello",
"YARD_GATE_LOOK": "Il cancello che dà sul retro dell'isolato. È chiuso con una catena e un lucchetto, e il lucchetto è più nuovo del cancello.",
"YARD_GATE_ACT": "La catena ha un giro di troppo. Chi l'ha chiusa non voleva rischiare di ricordarsi male.",
"YARD_GATE_REACH": "Di là c'è il retro dell'isolato, e il retro dell'isolato è un altro quartiere. Oggi non ci arrivi.",
"BAR_DOOR": "Porta del bar",
"BAR_DOOR_LOOK": "La porta del bar, con il vetro smerigliato e la tendina. Da dentro, la strada è una macchia arancione.",
"BAR_DOOR_REACH": "Esci nel vicolo.",
"BAR_DOOR_LOCKED": "Hai firmato. Adesso resti finché non è finita: uscire mentre uno raccoglie le sue carte è la cosa che non si fa.",
"BAR_CLOCK": "Orologio",
"BAR_CLOCK_LOOK": "L'orologio del bar, sopra il bancone. Segna mezzanotte e qualcosa, e non c'è nient'altro in questa stanza che dica che ora è.",
"BAR_CLOCK_LOOK_KNOWN": "L'orologio va avanti di sette minuti. Da quanto, non si sa. Da stasera, importa.",
"BAR_COUNTER": "Bancone",
"BAR_COUNTER_LOOK": "Un bancone di legno lucido consumato al centro, dove per trent'anni la gente ha appoggiato i gomiti sempre nello stesso punto.",
"BAR_COUNTER_ACT": "Ci appoggi i gomiti anche tu. È il posto più comodo in cui sei stato oggi, e non è una gran classifica.",
"BAR_PAPERS": "Carte di Duilio",
"BAR_PAPERS_LOOK": "Tre fogli aperti sul bancone, con un riquadro in fondo e sopra il riquadro una riga: FIRMA DEL TESTIMONE, RESIDENTE.",
"BAR_PAPERS_LOOK_SIGNED": "Le carte, con il tuo nome in fondo. Adesso che le guardi con calma, vedi anche il resto: la destinazione è un codice, e l'orario è fra undici minuti.",
"BAR_PAPERS_HAND": "Non sono tue. Toccare le carte di un altro è esattamente il genere di cosa per cui questa giornata ti ha punito tutto il giorno.",
"BAR_DUILIO": "Duilio",
"BAR_DUILIO_LOOK": "Duilio al bancone, senza cardigan e con la stessa tazza. Ha davanti tre fogli e la faccia di chi ha già deciso.",
"STREET_ALLEY_LOCKED": "Il vicolo porta al bar, e il bar apre la sera. Adesso c'è solo una saracinesca e il rumore del furgone dietro di te.",
"LOBBY_ARCHIVE_DOOR": "Porta del sottoscala",
"LOBBY_ARCHIVE_DOOR_LOOK": "Una porta bassa sotto le scale, socchiusa. Sopra c'è scritto ARCHIVO, con una V che qualcuno ha corretto in una C e poi ha lasciato perdere.",
"LOBBY_ARCHIVE_DOOR_REACH": "Entri nel sottoscala.",
"TUBES_YARD_DOOR": "Porta del cortile",
"TUBES_YARD_DOOR_LOOK": "Una porta di servizio in fondo alla galleria, con una toppa e nessuna maniglia. Dà sul cortile, dove la linea corre all'aperto.",
"TUBES_YARD_DOOR_REACH": "Esci nel cortile.",
"TUBES_YARD_DOOR_LOCKED": "È chiusa a chiave. La toppa è pulita, quindi la chiave esiste: semplicemente non ce l'hai tu.",
"STATION_LOG_NOT_YET": "Apri il registro alla prima riga libera e ti fermi. Ogni riga vuole un numero di protocollo prima del resto, e tu quel numero non ce l'hai.",
"STATION_CONSOLE_ACT": "Avvii lo spurgo. Il terminale chiede in quale punto della sezione, e tu non lo sai: da qui dentro la linea è un tubo che entra in un muro.",
"ITEM_BACKYARD_KEY": "Chiave del cortile",
"ITEM_BACKYARD_KEY_LOOK": "Una chiave con un cartellino di cartone: CORTILE. È stata spedita a questo ufficio due anni e mezzo fa e nessuno l'ha mai tolta dalla busta.",
"ITEM_NOTIFICATION": "Notifica di occupazione",
"ITEM_NOTIFICATION_LOOK": "La notifica: dichiara che l'immobile della pratica 41/9-C risulta occupato. In fondo, la ricevuta da staccare e firmare.",
"ITEM_BACKLOG": "Arretrato",
"ITEM_BACKLOG_LOOK": "Tre anni di certificati di occupazione, legati con lo spago. Ognuno dice che da qualche parte abita qualcuno, e nessuno di loro è mai partito.",
"SEQ_CELLAR_MANIFEST_1": "La distinta è lunga tre colonne. Cerchi il tuo palazzo e lo trovi subito, perché è in cima: pratica 41/9-C.",
"SEQ_CELLAR_MANIFEST_2": "Accanto c'è il numero di spedizione. È lungo undici cifre, e non è il numero del palazzo: è il numero del carico di cui il palazzo fa parte.",
"SEQ_YARD_FROST_1": "Qui fuori la linea è coperta di brina, perché dentro passa aria fredda a tutta velocità. La segui con gli occhi.",
"SEQ_YARD_FROST_2": "La brina si ferma di netto dopo il terzo giunto. Da lì in poi il tubo è asciutto: l'aria arriva fin lì e non passa. Il giunto porta un numero, e il numero è dodici.",
"SEQ_BAR_CLOCK_1": "L'orologio del bar segna mezzanotte e sette. Tiri fuori la ricevuta e guardi l'ora stampata sotto la tua firma.",
"SEQ_BAR_CLOCK_2": "Le ventitré e cinquantuno. Ci hai messo due minuti ad arrivare qui dal vicolo. L'orologio del bar va avanti di sette minuti, e stasera sette minuti sono tutto quello che hai.",
"SEQ_LOBBY_RULES_1": "Leggi il regolamento fino in fondo, che è una cosa che non fa nessuno.",
"SEQ_LOBBY_RULES_2": "COMMA 9: la numerazione dei protocolli è progressiva per anno di esercizio e riparte da uno all'apertura di ciascun esercizio. Te lo segni, senza sapere ancora perché.",
"SEQ_PURGE_1": "Digiti la sezione 4, giunto dodici. Il terminale ci pensa su più a lungo di quanto una macchina dovrebbe.",
"SEQ_PURGE_2": "Poi apre tutte e tre le valvole insieme, e nel muro succede una cosa che non è un rumore ma una spinta.",
"SEQ_PURGE_3": "Silenzio. Poi la spia rossa si spegne e ne resta una verde che non avevi mai visto accesa. La linea è libera per tutta la sua lunghezza.",
"SEQ_END_1": "Duilio conta le righe con il dito, arriva alla tua firma e si ferma un secondo di troppo.",
"SEQ_END_2": "«Grazie.» Piega i tre fogli in quattro, se li mette nella tasca del cardigan e finisce la tazza in piedi.",
"SEQ_END_3": "Alla porta si volta. «Ti direi di venire, ma non c'è posto per due e tu adesso risulti da qualche parte.» Poi non c'è più.",
"SEQ_END_4": "Fuori comincia un rumore basso che non è un motore. Dura molto. I bicchieri sul bancone si toccano fra loro senza che nessuno li abbia spostati.",
"SEQ_END_5": "Poi il rumore di una saracinesca — enorme, lentissima, e non è quella del bar.",
"SEQ_END_6": "E poi niente. Un locale con dentro te, e fuori dal vetro smerigliato nessuna macchia arancione. Guardi l'orologio: mezzanotte e nove. Cioè mezzanotte e due.",
"DLG_DUILIO_START": "«Buongiorno. Ti hanno messo il foglio anche a te, vedo.»",
"DLG_DUILIO_OPT_CALM": "Tu sembri tranquillo.",
"DLG_DUILIO_REPLY_CALM": "«Ho smesso di essere agitato tre settimane fa, quando ho capito che non serviva. È stato un sollievo. Consigliato.»",
"DLG_DUILIO_OPT_WITNESS": "Cosa farai?",
"DLG_DUILIO_REPLY_WITNESS": "«Parto. Ho un posto su una cosa che parte. Mi serve un testimone che firmi le carte, e il testimone dev'essere residente qui.» Ti guarda. «Tu lo sei.»",
"DLG_DUILIO_OPT_WHEN": "Quando ti servirebbe?",
"DLG_DUILIO_REPLY_WHEN": "«Stasera al bar, in fondo al vicolo. Non prima: le carte non sono ancora firmate dall'altra parte.» Beve. «E non dopo mezzanotte, per il motivo che immagini.»",
"DLG_DUILIO_OPT_NOTICE": "Hai letto il foglio?",
"DLG_DUILIO_REPLY_NOTICE": "«L'ho letto tre volte. Alla terza ho notato che non dice mai la parola casa. Dice immobile, pertinenza, superficie. Sono parole che si possono spostare.»",
"DLG_DUILIO_OPT_BYE": "Devo andare.",
"DLG_DUILIO_REPLY_BYE": "«Vai, vai. Ho tutto il giorno, io.»",
"DLG_BAR_START": "«Eccoti. Cominciavo a pensare che avessi avuto una giornata.»",
"DLG_BAR_OPT_WHAT": "Ho avuto una giornata.",
"DLG_BAR_REPLY_WHAT": "«Si vede dalla scatola.» Indica le carte. «Serve solo una firma. La tua.»",
"DLG_BAR_OPT_SIGN": "Firmo io.",
"DLG_BAR_REPLY_SIGN": "«Il testimone dev'essere residente.» Fa un cenno verso l'orologio. «E secondo quello lì, da nove minuti non lo sei più. Mi dispiace davvero.»",
"DLG_BAR_OPT_CLOCK": "Quell'orologio va avanti.",
"DLG_BAR_CLOCK": "Duilio guarda l'orologio, poi te. «Va avanti da quando ho cominciato a venire qui. Non è una prova, è un'abitudine.»",
"DLG_BAR_OPT_SHOW": "Questa ricevuta è di venti minuti fa e ha l'ora stampata.",
"DLG_BAR_REPLY_SHOW": "Confronta i due numeri due volte. Poi gira le carte verso di te e ti mette la penna in mano. «Un documento contro un orologio.» Firmi. «Da quando in qua vinci queste cose?»",
"DLG_BAR_OPT_NOT_YET": "Lascia stare.",
"DLG_BAR_OPT_BYE": "Torno subito.",
"DLG_BAR_REPLY_BYE": "«Sbrigati. Io non ho fretta, ma quello lì sì.» Indica l'orologio.",
"DLG_CONSOLE_OPT_NUMBER": "Che numero di protocollo devo usare?",
"DLG_CONSOLE_NUMBER": "IL NUMERO LO STAMPA LA PROTOCOLLATRICE. LA PROTOCOLLATRICE È A VALLE DELLA LINEA. LEI DEVE DEDURLO. GLIELO DICO COME SE FOSSE NORMALE.",
"DLG_CONSOLE_OPT_N_NEXT": "Il successivo dell'ultimo scritto?",
"DLG_CONSOLE_REPLY_N_NEXT": "SE CONOSCESSE LA REGOLA NON ME LO CHIEDEREBBE. LA REGOLA È AFFISSA IN ATRIO, DOVE IO NON POSSO ANDARE E LEI NEMMENO.",
"DLG_CONSOLE_OPT_N_ONE": "Uno.",
"DLG_CONSOLE_REPLY_N_ONE": "UNO. PERCHÉ LA NUMERAZIONE RIPARTE A OGNI ESERCIZIO E NESSUNO HA PROTOCOLLATO NIENTE PER TRE ESERCIZI. È IL PRIMO ATTO DI QUEST'ANNO E SIAMO A NOVEMBRE.",
"DLG_CONSOLE_OPT_N_GUESS": "Facciamo quattromiladodici.",
"DLG_CONSOLE_REPLY_N_GUESS": "NO. E LA RINGRAZIO PER AVERCI PROVATO CON TANTA SICUREZZA.",
"DLG_CONSOLE_OPT_N_BACK": "Aspetta.",
"DLG_CONSOLE_OPT_PURGE": "La linea adesso è libera?",
"DLG_CONSOLE_REPLY_PURGE": "NO. HO INVERTITO, NON SPURGATO. LA SEZIONE 4 È ANCORA CHIUSA E FINCHÉ È CHIUSA QUESTO UFFICIO RICEVE E NON SPEDISCE. PER LO SPURGO SERVE IL PUNTO ESATTO.",
"DLG_CONSOLE_OPT_EMIT": "Emetti la notifica per la pratica 41/9-C.",
"DLG_CONSOLE_REPLY_EMIT": "EMESSA. È IL PRIMO DOCUMENTO CHE QUESTO UFFICIO PRODUCE DA TRE ANNI E NON MI SEMBRA DI PROVARE NIENTE. LA CONSEGNI A MANO: L'INDIRIZZO RISULTA IN MOVIMENTO.",
"DLG_CONSOLE_OPT_SENT": "La notifica è emessa.",
"DLG_CONSOLE_REPLY_SENT": "SÌ. ADESSO VA CONSEGNATA, E UNA CONSEGNA NON È TALE FINCHÉ QUALCUNO NON FIRMA. NON GUARDI ME.",
"DLG_CONSOLE_OPT_FILE": "Emetti la notifica.",
"DLG_CONSOLE_REPLY_FILE": "PER QUALE PRATICA. NON BASTA UN INDIRIZZO: SERVE IL NUMERO DI SPEDIZIONE DEL CARICO IN CUI L'IMMOBILE È STATO INSERITO. È SULLA DISTINTA DEI TRASLOCATORI, CHE NON È UN NOSTRO DOCUMENTO."
}
