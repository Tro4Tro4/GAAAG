[gd_resource type="Resource" script_class="LocaleTexts" load_steps=2 format=3 uid="uid://baggatextit001"]

[ext_resource type="Script" path="res://scripts/text/locale_texts.gd" id="1_texts"]

[resource]
script = ExtResource("1_texts")
locale = "it"
entries = {
"PROTO_LOBBY_DOOR_LOOK_OPEN": "La porta è aperta, e dal corridoio entra una lama di luce che si allarga sul pavimento fin quasi alle sedie.",
"PROTO_TUBES_DOOR_LOOK_OPEN": "La porta è spalancata sull'atrio. Da qui si vede il pavimento di là: lo stesso grigio, ma con l'aria di essersene accorto.",
"PROTO_STATION_LEVER_ACT_DONE": "La leva è già giù. La linea gira al contrario e nessuno le ha chiesto fino a quando.",
"CHAR_NORA": "Nora",
"CHAR_CESARE": "Cesare",
"ITEM_FORM_BLANK": "Modulo di reclamo",
"ITEM_FORM_BLANK_LOOK": "Un modulo di reclamo, vuoto. Alla voce «sezione interessata» c'è un riquadro con scritto: riportare la targhetta in originale.",
"ITEM_PLATE": "Targhetta SEZIONE 4",
"ITEM_PLATE_LOOK": "Una targhetta smaltata che dice SEZIONE 4. Era avvitata sotto l'oblò, con una vite sola e già mezza fuori.",
"ITEM_FORM_FILLED": "Reclamo compilato",
"ITEM_FORM_FILLED_LOOK": "Il modulo con la targhetta appiccicata dentro il riquadro. In originale, come richiesto.",
"ITEM_RENEWAL": "Rinnovo dell'accreditamento",
"ITEM_RENEWAL_LOOK": "Il rinnovo dell'accreditamento della ditta. Data di spedizione: tre anni fa. Data di consegna: un riquadro vuoto.",
"COMBO_FORM_PLATE": "Stacchi il retro della targhetta e la appiccichi nel riquadro. Il modulo adesso dice SEZIONE 4 in originale, che è esattamente quello che chiedeva.",
"PROTO_LOBBY_NOTICE": "Regolamento",
"PROTO_LOBBY_NOTICE_LOOK": "REGOLAMENTO, COMMA 6: i reclami del pubblico viaggiano sulla linea di ritorno. COMMA 7: il personale non è pubblico.",
"PROTO_LOBBY_FORMS": "Portamoduli",
"PROTO_LOBBY_FORMS_LOOK": "Un portamoduli a parete con due scomparti: RECLAMI e RECLAMI SUL PORTAMODULI. Il secondo è vuoto.",
"PROTO_LOBBY_FORMS_HAND": "Prendi un modulo di reclamo dallo scomparto pieno.",
"PROTO_LOBBY_FORMS_TAKEN": "Nel primo scomparto ce ne sono altri quaranta. Nel secondo continua a non esserci niente.",
"PROTO_LOBBY_DOOR": "Porta del corridoio",
"PROTO_LOBBY_DOOR_LOOK": "La porta verso il corridoio dei tubi. Sopra, un cartello: SOLO PERSONALE AUTORIZZATO E ISPETTORI.",
"PROTO_LOBBY_DOOR_REACH": "Entri nel corridoio. Il tuo tesserino non protesta.",
"PROTO_LOBBY_CHAIRS": "Sedie",
"PROTO_LOBBY_CHAIRS_LOOK": "Quattro sedie in fila per un atrio dove non aspetta nessuno da parecchio. Su una c'è la forma di qualcuno, in polvere.",
"PROTO_TUBES_PIPE": "Tubatura",
"PROTO_TUBES_PIPE_LOOK": "La posta pneumatica corre lungo tutto il muro e si perde in fondo. È l'unico modo che questo posto ha di dirsi le cose.",
"PROTO_TUBES_PIPE_ACT": "Allunghi la mano e la ritiri. Toccare l'impianto sotto collaudo invalida il collaudo, e il collaudo è l'unica cosa che vi tiene aperti.",
"PROTO_TUBES_PORTHOLE": "Oblò d'ispezione",
"PROTO_TUBES_PORTHOLE_LOOK": "Dentro l'oblò c'è una capsula ferma di traverso. Sotto, una targhetta: SEZIONE 4.",
"PROTO_TUBES_PORTHOLE_LOOK_CLEAR": "Dentro l'oblò non c'è più niente, e il vetro è pieno di polvere che prima era da qualche altra parte.",
"PROTO_TUBES_PORTHOLE_ACT": "L'oblò si apre solo dall'interno dell'impianto, e l'impianto è quello che stai collaudando.",
"PROTO_TUBES_PLATE": "Targhetta",
"PROTO_TUBES_PLATE_LOOK": "SEZIONE 4, avvitata sotto l'oblò con una vite sola. La segnaletica non è impianto: su questo il regolamento è chiarissimo.",
"PROTO_TUBES_PLATE_HAND": "Sviti la targhetta con l'unghia. La segnaletica non è impianto, e questa è una distinzione che oggi ti salva la giornata.",
"PROTO_TUBES_POINT": "Punto d'imbucata",
"PROTO_TUBES_POINT_LOOK": "Il punto d'imbucata pubblico. Una bocca di ottone e sopra, a lettere piccole: PUBBLICO. RITIRI DALLO SPORTELLO ADIACENTE, CHE NON C'È.",
"PROTO_TUBES_POINT_HAND": "Dentro non c'è niente. La linea di ritorno funziona: è l'andata che è ferma alla sezione 4.",
"PROTO_TUBES_POINT_POSTED": "Imbuchi. Un soffio se lo porta via, e per la prima volta oggi qualcosa in questo posto si muove.",
"PROTO_TUBES_POINT_WAITING": "Dalla bocca di ottone spunta qualcosa. Qualcuno dall'altra parte ha imbucato.",
"PROTO_TUBES_DOOR": "Porta dell'atrio",
"PROTO_TUBES_DOOR_LOOK": "La porta da cui sei entrata. Da questo lato non c'è nessun cartello, il che è una posizione.",
"PROTO_TUBES_DOOR_REACH": "Torni nell'atrio.",
"PROTO_TUBES_CAPSULE": "Capsula",
"PROTO_TUBES_CAPSULE_LOOK": "La capsula che era ferma alla sezione 4. È uscita dal punto pubblico con un tonfo e adesso sta lì, ammaccata e paziente.",
"PROTO_TUBES_CAPSULE_HAND": "Apri la capsula. Dentro c'è un foglio solo, e lo leggi due volte.",
"PROTO_STATION_CONSOLE": "Console",
"PROTO_STATION_CONSOLE_LOOK": "La console della posta pneumatica. Una spia rossa, una leva, e un terminale che risponde a chi glielo chiede.",
"PROTO_STATION_LEVER": "Leva d'inversione",
"PROTO_STATION_LEVER_LOOK": "La leva che manda la linea al contrario. Sopra, un'etichetta: SOLO CON MOTIVO PROTOCOLLATO.",
"PROTO_STATION_LEVER_ACT": "Tiri la leva. La leva non si muove: senza un motivo protocollato è solo un pezzo di ottone attaccato al muro.",
"PROTO_STATION_LOG": "Registro",
"PROTO_STATION_LOG_LOOK": "Il registro dei motivi. L'ultima riga è di tre anni fa e dice: nessun motivo.",
"PROTO_STATION_LOG_ACT": "Sfogli il registro. Righe vuote fino in fondo, tutte con la data già stampata.",
"PROTO_STATION_LOG_ACCEPTED": "Protocolli il reclamo. Il registro ha una riga in più, e adesso l'inversione della linea ha un motivo.",
"PROTO_STATION_POINT": "Bocchetta di servizio",
"PROTO_STATION_POINT_LOOK": "La bocchetta di servizio, dove arriva quello che il pubblico imbuca. Non ci arriva niente dal 2019.",
"PROTO_STATION_POINT_HAND": "Vuota. Come da tre anni a questa parte.",
"PROTO_STATION_POINT_POSTED": "Imbuchi. Parte, e speri che dall'altra parte ci sia qualcuno.",
"PROTO_STATION_POINT_WAITING": "Nella bocchetta c'è qualcosa. Qualcosa. Nella bocchetta.",
"DLG_CONSOLE_START": "TERMINALE PRONTO. LINEA OSTRUITA. NON CHIEDA DOVE.",
"DLG_CONSOLE_OPT_WHERE": "Dove è ostruita?",
"DLG_CONSOLE_REPLY_WHERE": "GLIEL'HO DETTO DI NON CHIEDERE. IL TERMINALE NON VEDE L'INTERNO DELLA LINEA: PER QUELLO C'È L'OBLÒ, CHE È IN CORRIDOIO.",
"DLG_CONSOLE_OPT_REVERSE": "Posso invertire la linea?",
"DLG_CONSOLE_REPLY_REVERSE": "CON UN MOTIVO PROTOCOLLATO. UN MOTIVO VALIDO È UN RECLAMO DEL PUBBLICO. LEI NON È PUBBLICO: LEI È QUI.",
"DLG_CONSOLE_OPT_COMPLAIN": "Presento io un reclamo.",
"DLG_CONSOLE_REPLY_COMPLAIN": "IL PERSONALE IMBUCA I RECLAMI NELLA BOCCHETTA DI SERVIZIO. LA BOCCHETTA DI SERVIZIO È SULLA LINEA OSTRUITA. NOTI L'ELEGANZA.",
"DLG_CONSOLE_OPT_READY": "Ho un reclamo protocollato.",
"DLG_CONSOLE_REPLY_READY": "ALLORA LA LEVA SI MUOVERÀ. LO DICO SENZA ENTUSIASMO PERCHÉ NON NE HO.",
"DLG_CONSOLE_OPT_BYE": "Va bene.",
"DLG_CONSOLE_REPLY_BYE": "TERMINALE IN ATTESA. COME SEMPRE.",
"SEQ_LEVER_PULL": "Tiri la leva, e stavolta scende.",
"SEQ_LEVER_RUMBLE": "Il tubo fa un rumore che non faceva da tre anni. Qualcosa di pesante torna indietro lungo tutto il muro.",
"SEQ_LEVER_END": "Poi silenzio, e un tonfo lontano dalla parte dell'atrio.",
"COMBO_STICKER_BUTTON": "Stacchi l'adesivo e lo appiccichi sul pulsante. Adesso il pulsante dice NON IMPILARE.",
"DLG_CLERK_FORM": "Ecco il 12-B. Lo compili in duplice copia e ne consegni tre.",
"DLG_CLERK_OPT_BACK": "Va bene.",
"DLG_CLERK_OPT_BYE": "Arrivederci.",
"DLG_CLERK_OPT_FORM": "Mi serve il modulo 12-B.",
"DLG_CLERK_OPT_LOOP": "Ma lo sportello è chiuso.",
"DLG_CLERK_OPT_STICKER": "Di là qualcuno ha staccato un adesivo da una cassa.",
"DLG_CLERK_OPT_THIRD": "E la terza copia?",
"DLG_CLERK_REPLY_BYE": "Sportello chiuso.",
"DLG_CLERK_REPLY_LOOP": "Esatto. Vedo che si è già documentato.",
"DLG_CLERK_REPLY_STICKER": "Era un adesivo di sicurezza. Adesso la cassa è insicura, e la cosa la riguarda.",
"DLG_CLERK_REPLY_THIRD": "La terza la tiene lei, per ricordarsi delle altre due.",
"DLG_CLERK_START": "Sportello chiuso. Per aprirlo serve il modulo 12-B, che si ritira allo sportello.",
"GENERIC_COMBINE_REFUSAL": "Insieme non fanno assolutamente niente.",
"GENERIC_DOOR_CLOSE": "Chiudi la porta.",
"GENERIC_DOOR_OPEN": "Apri la porta.",
"GENERIC_ITEM_REFUSAL": "Non c'entra niente con questo.",
"GENERIC_PASSAGE_EMPTY": "Non c'è niente, per ora.",
"GENERIC_PASSAGE_POSTED": "Sparisce dall'altra parte.",
"GENERIC_PASSAGE_TAKE": "Prendi %s.",
"GENERIC_REFUSAL": "Non mi sembra il caso.",
"ITEM_BUTTON": "Pulsante",
"ITEM_BUTTON_LOOK": "Un pulsante grigio, staccato da tutto. Premerlo adesso non fa niente, ma lo fa con molta convinzione.",
"ITEM_FORM": "Modulo 12-B",
"ITEM_FORM_LOOK": "Un modulo 12-B. Alla voce «motivo della richiesta» c'è scritto, a stampa, «vedi voce successiva». La voce successiva non c'è.",
"ITEM_LABELLED_BUTTON": "Pulsante etichettato",
"ITEM_LABELLED_BUTTON_LOOK": "Un pulsante che dice NON IMPILARE. Non è chiaro cosa succeda premendolo, ed è precisamente questo il punto.",
"ITEM_STICKER": "Adesivo",
"ITEM_STICKER_LOOK": "Un adesivo che dice NON IMPILARE. Il retro è ancora appiccicoso, il che lo rende un'opinione trasferibile.",
"MENU_LOAD": "Carica",
"MENU_QUIT": "Esci",
"MENU_SETTINGS": "Impostazioni",
"MENU_LOAD_AUTO": "Carica l'ultimo automatico",
"MENU_NEW_GAME": "Nuova partita",
"MENU_SAVE": "Salva",
"SETTINGS_LANGUAGE": "Lingua",
"SETTINGS_MUSIC": "Musica: %d%%",
"SETTINGS_SOUND": "Effetti: %d%%",
"SETTINGS_TITLE": "Impostazioni",
"TITLE_CONTINUE": "Continua",
"ROOM_HALL_CLERK": "Impiegato",
"ROOM_HALL_CLERK_LOOK": "Un impiegato dietro un banco che non c'è. Sta comunque come se il banco ci fosse.",
"ROOM_HALL_DISPENSER": "Distributore",
"ROOM_HALL_DISPENSER_ACT": "Premi i pulsanti uno dopo l'altro. La macchina ronza, si spegne, si riaccende e torna come prima.",
"ROOM_HALL_DISPENSER_HAND": "Premi un pulsante a caso. La macchina si illumina, ronza, e ti restituisce il pulsante.",
"ROOM_HALL_DISPENSER_LOOK_ANNOYED": "Il distributore è acceso e non fa niente. Da qui sembra un modo di stare fermi molto attivo.",
"SEQ_DISPENSER_END": "La macchina si spegne. Poi si riaccende, e adesso ronza a una nota più alta.",
"ROOM_HALL_DISPENSER_LOOK": "Un distributore automatico. Sette pulsanti, tutti con la stessa etichetta illeggibile.",
"ROOM_HALL_DISPENSER_TAKEN": "Gli altri sei pulsanti restano al loro posto. Sembrano più uniti di prima.",
"ROOM_HALL_DOOR": "Porta",
"ROOM_HALL_DOOR_CLOSE": "Chiudi la porta. Dall'altra parte, immagini, non se ne accorge nessuno.",
"ROOM_HALL_DOOR_LOOK": "La porta da cui sei arrivato. Da questo lato non c'è scritto niente.",
"ROOM_HALL_DOOR_OPEN": "Apri la porta. Da questo lato i cardini sono più cortesi.",
"ROOM_HALL_DOOR_REACH": "Torni dentro. La stanza non si è mossa.",
"ROOM_HALL_FARDOOR": "Porta in fondo",
"ROOM_HALL_FARDOOR_LOOK": "Un'altra porta, in fondo al corridoio. Sopra, una freccia che punta verso la porta stessa.",
"ROOM_HALL_FARDOOR_REACH": "Attraversi la porta in fondo. Il corridoio di là è molto più lungo di questo.",
"ROOM_LONG_DOOR": "Porta",
"ROOM_LONG_DOOR_LOOK": "La porta da cui sei entrato. Da questo lato sembra più lontana di quanto sia.",
"ROOM_LONG_DOOR_REACH": "Torni indietro, e il corridoio si accorcia di colpo.",
"ROOM_LONG_WINDOW": "Finestra",
"ROOM_LONG_WINDOW_LOOK": "Una finestra. Fuori c'è un altro corridoio, con una finestra.",
"ROOM_HALL_SIGN": "Cartello",
"ROOM_HALL_SIGN_ACCEPTED": "Appiccichi il pulsante sotto la scritta. Adesso il cartello dice LIVELLO 4, NON IMPILARE: sembra molto meno un'informazione.",
"ROOM_HALL_SIGN_ACT": "Tiri il cartello verso di te. È avvitato al muro. Molto avvitato.",
"ROOM_HALL_SIGN_LOOK": "Un cartello: LIVELLO 4. Qualcuno ha cancellato il 4 e ha riscritto 4, con più decisione.",
"ROOM_HALL_SIGN_REACH": "Il cartello non risponde. Insiste a sostenere di essere il livello 4.",
"ROOM_HALL_SLOT": "Fessura",
"ROOM_HALL_SLOT_HAND": "Dentro non c'è niente. La targhetta continua a dire RITIRO, imperterrita.",
"ROOM_HALL_SLOT_LOOK": "La stessa fessura, da questo lato. Qui la targhetta dice MODULISTICA (RITIRO).",
"ROOM_HALL_SLOT_POSTED": "Infili l'oggetto nella fessura. Si sente un tonfo dall'altra parte, poi silenzio.",
"ROOM_HALL_SLOT_WAITING": "Nella fessura c'è qualcosa che prima non c'era.",
"ROOM_TEST_CRATE": "Cassa",
"ROOM_TEST_CRATE_ACT": "Spingi il coperchio con tutte e due le mani. La cassa si sposta di un centimetro e si rimette dov'era.",
"ROOM_TEST_CRATE_HAND": "Il coperchio non cede di un millimetro. L'adesivo invece viene via subito.",
"ROOM_TEST_CRATE_LOOK": "Una cassa di metallo. Sul coperchio un adesivo dice NON IMPILARE.",
"ROOM_TEST_CRATE_LOOK_PEELED": "Una cassa di metallo. Dove stava l'adesivo il grigio è più chiaro, e la cassa ha smesso di avere opinioni sull'impilamento.",
"ROOM_TEST_CRATE_TAKEN": "Sul coperchio resta un rettangolo più pulito, che non dice niente a nessuno.",
"ROOM_TEST_DOOR": "Porta",
"ROOM_TEST_DOOR_CLOSE": "Chiudi la porta. I cardini ripetono la stessa frase al contrario.",
"ROOM_TEST_DOOR_LOOK": "Una porta. Sopra c'è scritto USCITA, ma la freccia punta in basso.",
"ROOM_TEST_DOOR_OPEN": "Apri la porta. I cardini protestano in una lingua che non conosci.",
"ROOM_TEST_DOOR_REACH": "Attraversi la porta. Di là c'è un corridoio, il che è già un'informazione.",
"ROOM_TEST_DRAFT": "Spiffero",
"ROOM_TEST_DRAFT_LOOK": "Dalla porta aperta arriva aria tiepida che sa di moquette e di comunicazioni di servizio.",
"ROOM_TEST_SLOT": "Fessura",
"ROOM_TEST_SLOT_HAND": "Ci infili la mano fino al polso. Dentro c'è solo muro.",
"ROOM_TEST_SLOT_LOOK": "Una fessura nel muro, all'altezza del petto. Sotto, una targhetta smaltata: MODULISTICA.",
"ROOM_TEST_SLOT_POSTED": "Infili l'oggetto nella fessura. Si sente un tonfo dall'altra parte, poi silenzio.",
"ROOM_TEST_SLOT_WAITING": "Dalla fessura spunta qualcosa. Qualcuno l'ha imbucato dall'altro lato.",
"UI_BAG": "Zaino",
"UI_EMPTY_BAG": "Non hai niente.",
"UI_LOADED": "Partita caricata.",
"UI_LOAD_FAILED": "Questo salvataggio non si può leggere.",
"UI_MENU": "Menù",
"UI_NOTHING_TO_LOAD": "Non c'è niente da caricare.",
"UI_SAVED": "Partita salvata.",
"UI_SAVE_FAILED": "Non è stato possibile salvare.",
