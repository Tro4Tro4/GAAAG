[gd_resource type="Resource" script_class="Sequence" load_steps=12 format=3 uid="uid://baggaseqdisp01"]

[ext_resource type="Script" path="res://scripts/sequence/sequence.gd" id="1_sequence"]
[ext_resource type="Script" path="res://scripts/sequence/sequence_step.gd" id="2_step"]
[ext_resource type="AudioStream" path="res://assets/audio/chime.wav" id="3_chime"]

[sub_resource type="Resource" id="Step_say_pressing"]
script = ExtResource("2_step")
kind = 0
text = "ROOM_HALL_DISPENSER_ACT"

[sub_resource type="Resource" id="Step_chime"]
script = ExtResource("2_step")
kind = 4
sound = ExtResource("3_chime")

[sub_resource type="Resource" id="Step_wait"]
script = ExtResource("2_step")
kind = 1
seconds = 0.5

[sub_resource type="Resource" id="Step_step_back"]
script = ExtResource("2_step")
kind = 2
point = &"DispenserBack"

[sub_resource type="Resource" id="Step_face_machine"]
script = ExtResource("2_step")
kind = 3
point = &"DispenserFront"

[sub_resource type="Resource" id="Step_say_end"]
script = ExtResource("2_step")
kind = 0
text = "SEQ_DISPENSER_END"

[sub_resource type="Resource" id="Step_flag"]
script = ExtResource("2_step")
kind = 5
name = &"dispenser_annoyed"

[resource]
script = ExtResource("1_sequence")
steps = Array[ExtResource("2_step")]([SubResource("Step_say_pressing"), SubResource("Step_chime"), SubResource("Step_wait"), SubResource("Step_step_back"), SubResource("Step_face_machine"), SubResource("Step_say_end"), SubResource("Step_flag")])
